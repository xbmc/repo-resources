<?xml version="1.0" encoding="UTF-8"?>
<addon
  id="resource.language.sc_it"
  version="11.0.1"
  name="Sardinian"
  provider-name="Team Kodi">
  <requires>
    <import addon="kodi.resource" version="1.0.0"/>
  </requires>
  <extension
    point="kodi.resource.language"
    locale="sc_IT">
    <charsets>
      <gui>CP1252</gui>
      <subtitle>CP1252</subtitle>
    </charsets>
    <sorttokens>
      <token>Su</token>
      <token>Sa</token>
      <token>Sos</token>
      <token>Sas</token>
      <token separators="'">S</token>
      <token>Unu</token>
      <token>Una</token>
      <token separators="'">Un</token>
      <token>The</token>
    </sorttokens>
  </extension>
  <extension point="kodi.addon.metadata">
    <summary lang="en_GB">Sardinian language pack</summary>
    <summary lang="sc_IT">Pachete pro sa limba sarda</summary>
    <description lang="en_GB">Sardinian version of all texts used in Kodi.</description>
    <description lang="sc_IT">Versione in sardu de totu sos testos impreados in Kodi.</description>
    <platform>all</platform>
    <assets>
      <icon>icon.png</icon>
    </assets>
  </extension>
</addon>
