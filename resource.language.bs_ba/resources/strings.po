# strings from 36100 to 36999 are reserved for settings descriptions
#. Description of settings section "Appearance"
msgctxt "#36101"
msgid "Change the look and feel of the user interface."
msgstr "Promijenite izgled i dojam korisničkog interfejsa."

#. Description of settings category "Appearance -> Skin" with label #166
msgctxt "#36102"
msgid "This category contains all skin related settings."
msgstr "Ova kategorija sadrži sve postavke vezane za kožu."

#. Description of setting with label #166 "Skin"
msgctxt "#36103"
msgid "Select the skin for the user interface. This will define the look and feel of the application."
msgstr "Odaberite skin za korisnički interfejs. Ovo će definirati izgled i dojam aplikacije."

#. Description of setting with label #21417 "Settings"
msgctxt "#36104"
msgid "Select to change the skin specific settings. Which options are available for configuration depends on the features provided by the skin."
msgstr "Odaberite za promjenu postavki specifičnih za skin. Koje su opcije dostupne za konfiguraciju ovise o funkcijama koje skin pruža."

#. Description of setting with label #15111 "Theme"
msgctxt "#36105"
msgid "Change the theme associated with your selected skin."
msgstr "Promijenite temu povezanu s odabranom kožom."

#. Description of setting with label #14078 "Colours"
msgctxt "#36106"
msgid "Change the colours of your selected skin."
msgstr "Promijenite boje odabrane kože."

#. Description of setting with label #13303 "Fonts"
msgctxt "#36107"
msgid "Choose the fonts displayed in the user interface. The font sets are configured by your skin."
msgstr "Odaberite fontove koji se prikazuju u korisničkom interfejsu. Skupovi fontova su konfigurirani vašim skin-om."

#. Description of setting with label #20109 "Zoom"
msgctxt "#36108"
msgid "Resize the view of the user interface."
msgstr "Promijenite veličinu prikaza korisničkog interfejsa."

#. Description of setting with label #512 "Startup window"
msgctxt "#36109"
msgid "Select the media window to display on startup."
msgstr "Odaberite prozor medija koji će se prikazati pri pokretanju."

#. Description of setting with label #15108 "GUI sounds"
msgctxt "#36110"
msgid "Select or disable the sounds used in the user interface."
msgstr "Odaberite ili onemogućite zvukove koji se koriste u korisničkom interfejsu."

#. Description of setting with label #13305 "Show RSS news feed"
msgctxt "#36111"
msgid "Turn this off to remove the scrolling RSS news ticker."
msgstr "Isključite ovo da biste uklonili pomicanje RSS vijesti."

#. Description of setting with label #21450 "Edit"
msgctxt "#36112"
msgid "Edit the RSS feeds."
msgstr "Uredite RSS feedove."

#. Description of settings category with label #14090 "Regional"
msgctxt "#36113"
msgid "This category contains all locale / regional settings."
msgstr "Ova kategorija sadrži sve lokalne/regionalne postavke."

#. Description of setting with label #248 "Language"
msgctxt "#36114"
msgid "Chooses the language of the user interface."
msgstr "Bira jezik korisničkog interfejsa."

#. Description of setting with label #20026 "Region"
msgctxt "#36115"
msgid "Select the formats for temperature, time and date. The available options depend on the selected language."
msgstr "Odaberite formate za temperaturu, vrijeme i datum. Dostupne opcije zavise od odabranog jezika."

#. Description of setting with label #14091 "Character set"
msgctxt "#36116"
msgid "Choose which character set is used for displaying text in the user interface. This doesn't change the character set used for subtitles, for that go to Player > Language."
msgstr "Odaberite koji se skup znakova koristi za prikaz teksta u korisničkom interfejsu. Ovo ne mijenja skup znakova koji se koristi za titlove, za to idite na Player > Jezik."

#. Description of setting with label #285 "Preferred audio language"
msgctxt "#36119"
msgid "Defaults to the selected audio language if more than one language is available."
msgstr "Podrazumevano se koristi odabrani audio jezik ako je dostupno više od jednog jezika."

#. Description of setting with label #286 "Preferred subtitle language"
msgctxt "#36120"
msgid "Defaults to the selected subtitle language if more than one language is available."
msgstr "Podrazumevano se koristi odabrani jezik titlova ako je dostupno više jezika."

#. Description of settings with label #16000 "General"
msgctxt "#36121"
msgid "This category contains the settings for how media lists are displayed."
msgstr "Ova kategorija sadrži postavke za prikaz medijskih lista."

#. Description of setting with label #13306 "Show parent folder items"
msgctxt "#36122"
msgid "Display the (..) item in lists for visiting the parent folder."
msgstr "Prikaži stavku (..) u listama za posjetu nadređenoj mapi."

#. Description of setting with label #497 "Show file extensions"
msgctxt "#36123"
msgid "Show file extensions on media files, for example \"You Enjoy Myself\" would be shown as \"You Enjoy Myself.mp3\"."
msgstr "Prikaži ekstenzije datoteka na medijskim datotekama, na primjer \"You Enjoy Myself\" bi se prikazalo kao \"You Enjoy Myself.mp3\"."

#. Description of setting with label #13399 "Ignore articles when sorting"
msgctxt "#36124"
msgid "Ignore certain tokens, e.g. \"The\", during sort operations. \"The Simpsons\" would for example be sorted as \"Simpsons\"."
msgstr "Zanemarite određene tokene, npr. \"The\", tokom operacija sortiranja. \"The Simpsons\" bi, na primjer, bio sortiran kao \"Simpsons\"."

#. Description of setting with label #14071 "Allow file renaming and deletion"
msgctxt "#36125"
msgid "Allow files to be deleted and renamed through the user interface, via the context menu, e.g. press \"C\" on a keyboard to bring up this menu."
msgstr "Omogućite brisanje i preimenovanje datoteka putem korisničkog interfejsa, putem kontekstnog menija, npr. pritisnite \"C\" na tastaturi da biste otvorili ovaj meni."

#. Description of setting with label #21382 Show "Add source" buttons in files lists"
msgctxt "#36126"
msgid "Show the add source button in root sections of the user interface."
msgstr "Prikaži dugme za dodavanje izvora u glavnim dijelovima korisničkog interfejsa."

#. Description of setting with label #21330 "Show hidden files and directories"
msgctxt "#36127"
msgid "Show hidden files and directories when listing files."
msgstr "Prikaži skrivene datoteke i direktorije prilikom popisa datoteka."

#. Description of settings category with label #360 "Screensaver"
msgctxt "#36128"
msgid "This category contains the settings for how the screensaver add-ons are handled."
msgstr "Ova kategorija sadrži postavke za način na koji se rukuje dodacima za čuvare ekrana."

#. Description of setting with label #355 "Wait time"
msgctxt "#36129"
msgid "Set the time to wait for any activity to occur before displaying the screensaver."
msgstr "Postavite vrijeme čekanja za bilo kakvu aktivnost prije prikazivanja čuvara ekrana."

#. Description of setting with label #356 "Screensaver mode"
msgctxt "#36130"
msgid "Select the screensaver. The \"Dim\" screensaver will be forced when fullscreen video playback is paused or a dialogue box is active."
msgstr "Odaberite čuvar ekrana. Čuvar ekrana \"Zatamnjen\" će se prisilno aktivirati kada se pauzira reprodukcija videa preko cijelog ekrana ili je aktivan dijaloški okvir."

#. #. Description of setting with label #21417 "Settings"
msgctxt "#36131"
msgid "Select to change the screensaver specific settings. Which options are available for configuration depends on the features provided by the screensaver add-on."
msgstr "Odaberite da biste promijenili postavke specifične za čuvar ekrana. Koje su opcije dostupne za konfiguraciju ovise o funkcijama koje pruža dodatak za čuvar ekrana."

#. Description of setting with label #1000 "Preview"
msgctxt "#36132"
msgid "Preview the selected screensaver."
msgstr "Pregledajte odabrani čuvar ekrana."

#. Description of setting with label #22014 "Use dim if paused during video playback"
msgctxt "#36134"
msgid "Dim the display when media is paused. Not valid for the \"Dim\" screensaver mode."
msgstr "Zatamni ekran kada je medijski sadržaj pauziran. Ne važi za režim čuvara ekrana \"Zatamni\"."

msgctxt "#36135"
msgid "No info available yet."
msgstr "Još nema dostupnih informacija."

msgctxt "#36136"
msgid "No info available yet."
msgstr "Još nema dostupnih informacija."

msgctxt "#36137"
msgid "No info available yet."
msgstr "Još nema dostupnih informacija."

#. Description of settings section with label #3 "Videos"
msgctxt "#36138"
msgid "Section that contains settings related to videos and how they are handled."
msgstr "Odjeljak koji sadrži postavke vezane za videozapise i način na koji se oni obrađuju."

#. Description of settings category with label #14022 "Library"
msgctxt "#36139"
msgid "This category contains the settings for how the video library is handled."
msgstr "Ova kategorija sadrži postavke za način rukovanja videotekom."

#. Description of setting with label #14105 "Temperature unit"
msgctxt "#36140"
msgid "Choose which temperature unit is used for displaying temperatures in the user interface."
msgstr "Odaberite koja će se temperaturna jedinica koristiti za prikaz temperatura u korisničkom interfejsu."

#. Description of setting with label #20369 "Show information for unwatched items"
msgctxt "#36141"
msgid "Show information for unwatched media in the video library or hide them if not selected to prevent spoilers. Available options are 'Movie plot', 'Episode plot' and 'Episode thumb'."
msgstr "Prikažite informacije o nepregledanim medijima u videoteci ili ih sakrijte ako nisu odabrane kako biste spriječili spojlere. Dostupne opcije su 'Radnja filma', 'Radnja epizode' i 'Sličica epizode'."

#. Description of setting with label #14106 "Speed unit"
msgctxt "#36142"
msgid "Choose which speed unit is used for displaying speeds in the user interface."
msgstr "Odaberite koja će se jedinica brzine koristiti za prikaz brzina u korisničkom interfejsu."

#. Description of setting with label #20402 "Download actor thumbnails"
msgctxt "#36143"
msgid "Downloads thumbnails for actors from online databases when adding media to the library."
msgstr "Preuzima minijature za glumce iz online baza podataka prilikom dodavanja medija u biblioteku."

#. Description of setting with label #20412 "Flatten TV show seasons"
msgctxt "#36144"
msgid "Select in which cases you want to hide the season nodes of TV shows. If hidden, selecting a TV show will directly jump into the episodes view."
msgstr "Odaberite u kojim slučajevima želite sakriti čvorove sezona TV emisija. Ako su skriveni, odabirom TV emisije direktno ćete preći na prikaz epizoda."

#. Description of setting with label #20458 "Group movies in sets"
msgctxt "#36145"
msgid "When enabled, movies belonging to a \"Movie set\" are grouped together under one entry for the set in the movie library, this entry can then be opened to display the individual movies. When disabled, each movie will have its own entry in the movie library even if it belongs to a set."
msgstr "Kada je omogućeno, filmovi koji pripadaju \"Filmskom setu\" grupirani su pod jednim unosom za taj set u filmskoj biblioteci, a ovaj unos se zatim može otvoriti za prikaz pojedinačnih filmova. Kada je onemogućeno, svaki film će imati svoj unos u filmskoj biblioteci čak i ako pripada setu."

#. Description of setting with label #22000 "Update library on startup"
msgctxt "#36146"
msgid "Check for new media files on startup."
msgstr "Provjeri nove medijske datoteke pri pokretanju."

#. Description of setting with label #22001 "Hide progress of library updates"
msgctxt "#36147"
msgid "Hide the library scanning progress bar during scans."
msgstr "Sakrijte traku napretka skeniranja biblioteke tokom skeniranja."

#. Description of setting with label #334 "Clean library..."
msgctxt "#36148"
msgid "Remove items from your library that can't be found (either renamed, deleted, or on removable storage that is currently unplugged)."
msgstr "Uklonite stavke iz biblioteke koje se ne mogu pronaći (bilo da su preimenovane, izbrisane ili se nalaze na prenosivoj memoriji koja je trenutno isključena)."

#. Description of setting with label #647 "Export video library"
msgctxt "#36149"
msgid "Export the video library database to XML files. This will optionally overwrite your current XML files."
msgstr "Izvezite bazu podataka videoteke u XML datoteke. Ovo će opcionalno prepisati vaše trenutne XML datoteke."

#. Description of setting with label #648 "Import video library"
msgctxt "#36150"
msgid "Import an XML file into the video library database."
msgstr "Uvezite XML datoteku u bazu podataka videoteke."

#. Description of settings category with label #14086 "Playback"
msgctxt "#36151"
msgid "This category contains the settings for how video playback is handled."
msgstr "Ova kategorija sadrži postavke za način na koji se upravlja reprodukcijom videa."

#. Description of setting with label #13433 "Play next video automatically"
msgctxt "#36152"
msgid "Enable automatic playback of the next file in the list for selected playlist types."
msgstr "Omogući automatsku reprodukciju sljedeće datoteke na listi za odabrane tipove lista za reprodukciju."

#. Description of setting with label #13415 "Render method"
msgctxt "#36153"
msgid "Adjust the method used to process and display video."
msgstr "Prilagodite metodu koja se koristi za obradu i prikaz videa."

#. Description of setting with label #13435 "Enable HQ Scalers for scaling above"
msgctxt "#36154"
msgid "Use high quality scalers when upscaling a video by at least this percentage. A value below 5% makes little sense as video is processed with high GPU load without any visible picture quality improvements."
msgstr "Koristite visokokvalitetne skalere prilikom povećanja rezolucije videa za barem ovaj postotak. Vrijednost ispod 5% nema puno smisla jer se video obrađuje s velikim opterećenjem GPU-a bez ikakvih vidljivih poboljšanja kvalitete slike."

#. Description of setting with label #13425 "Allow hardware acceleration (VDPAU)"
msgctxt "#36155"
msgid "Enable VDPAU hardware decoding of video files, mainly used for NVIDIA graphics and in some circumstances AMD graphics."
msgstr "Omogućite VDPAU hardversko dekodiranje video datoteka, uglavnom se koristi za NVIDIA grafiku, a u nekim okolnostima i za AMD grafiku."

#. Description of setting with label #13426 "Allow hardware acceleration (VAAPI)"
msgctxt "#36156"
msgid "Enable VAAPI hardware decoding of video files, mainly used for Intel graphics and in some circumstances AMD graphics."
msgstr "Omogućite VAAPI hardversko dekodiranje video datoteka, uglavnom se koristi za Intel grafiku, a u nekim okolnostima i za AMD grafiku."

#. Description of setting with label #20470 "Use movie sets for single movies"
msgctxt "#36157"
msgid "When enabled, a \"Movie set\" entry is used even if the movie library contains only a single movie from that set. When disabled, a \"Movie set\" entry is used only if the movie library contains more than one movie from that set."
msgstr "Kada je omogućeno, unos \"Skup filmova\" se koristi čak i ako biblioteka filmova sadrži samo jedan film iz tog seta. Kada je onemogućeno, unos \"Skup filmova\" se koristi samo ako biblioteka filmova sadrži više od jednog filma iz tog seta."

#. Description of setting with label #13427 "Allow hardware acceleration (DXVA2)"
msgctxt "#36158"
msgid "Enable DXVA2 hardware decoding of video files."
msgstr "Omogući DXVA2 hardversko dekodiranje video datoteka."

#. Description of setting with label #13429 "Allow hardware acceleration (VDADecoder)"
msgctxt "#36160"
msgid "Enable VTB hardware decoding of video files."
msgstr "Omogući VTB hardversko dekodiranje video datoteka."

#. Description of setting with label #508 "Startup action"
msgctxt "#36161"
msgid "Select an action Kodi will perform on startup."
msgstr "Odaberite radnju koju će Kodi izvršiti pri pokretanju."

#. Description of setting with label #13432 "Allow hardware acceleration (VideoToolbox)"
msgctxt "#36162"
msgid "Enable VideoToolbox hardware decoding of video files."
msgstr "Omogući hardversko dekodiranje video datoteka u VideoToolboxu."

#. Description of setting with label #20471 "Show empty TV shows"
msgctxt "#36163"
msgid "Show TV shows with no episodes when browsing the video library."
msgstr "Prikaži TV emisije bez epizoda prilikom pregledavanja videoteke."

#. Description of setting with label #170 "Adjust display refresh rate"
msgctxt "#36164"
msgid "Allow the refresh rate of the display to be changed so that it best matches the video frame rate. This may yield smoother video playback."
msgstr "Omogućite promjenu brzine osvježavanja ekrana kako bi se najbolje podudarala s brzinom kadrova videa. Ovo može rezultirati glatkijom reprodukcijom videa."

#. Description of setting with label #13550 "Delay after change of refresh rate"
msgctxt "#36165"
msgid "Delay of reset event after a change of refresh rate"
msgstr "Kašnjenje resetovanja nakon promjene brzine osvježavanja"

#. Description of setting with label #13510 "Sync playback to display"
msgctxt "#36166"
msgid "Synchronise video and audio to the refresh rate of the monitor. VideoPlayer won't use passthrough audio in this case because resampling may be required."
msgstr "Sinhronizujte video i audio sa brzinom osvježavanja monitora. VideoPlayer u ovom slučaju neće koristiti prolazni audio jer bi moglo biti potrebno ponovno uzorkovanje."

#. Description of setting with label #14107 "Time format"
msgctxt "#36167"
msgid "Choose which time format is used for displaying the time in the user interface."
msgstr "Odaberite koji će se format vremena koristiti za prikaz vremena u korisničkom interfejsu."

#. Description of setting with label #14108 "Use 12/24-hour format"
msgctxt "#36168"
msgid "Choose whether to use 12 or 24-hour format for displaying the time in the user interface."
msgstr "Odaberite da li želite koristiti 12-satni ili 24-satni format za prikaz vremena u korisničkom interfejsu."

#. Description of setting with label #13505 "Resample quality"
msgctxt "#36169"
msgid "Select the quality of resampling for cases where the audio output needs to be at a different sampling rate from that used by the source.[CR][Low] Is fast and will have minimal impact on system resources such as the use of the CPU.[CR][Medium] & [High] Will use progressively more system resources."
msgstr "Odaberite kvalitet ponovnog uzorkovanja za slučajeve kada audio izlaz treba biti na drugačijoj brzini uzorkovanja od one koju koristi izvor. [CR][Nisko] Brzo je i imat će minimalan utjecaj na sistemske resurse kao što je korištenje CPU-a. [CR][Srednje] i [Visoko] Progresivno će koristiti više sistemskih resursa."

#. Description of setting with label #22021 "Minimise black bars"
msgctxt "#36170"
msgid "Stretch the video up to the set percentage in order to minimise black bars."
msgstr "Razvucite video do postavljenog procenta kako biste smanjili crne trake."

#. Description of setting with label #173 "Display 4:3 videos as"
msgctxt "#36171"
msgid "Select the zoom level that 4:3 videos are shown on widescreen displays."
msgstr "Odaberite nivo zumiranja za prikaz videozapisa u formatu 4:3 na ekranima širokog ekrana."

#. Description of setting with label #13430 "Allow hardware acceleration - PRIME"
msgctxt "#36172"
msgid "Enable PRIME decoding of video files"
msgstr "Omogući PRIME dekodiranje video datoteka"

#. Description of setting with label #14109 "Short date format"
msgctxt "#36173"
msgid "Choose which short date format is used for displaying the date in the user interface."
msgstr "Odaberite koji kratki format datuma će se koristiti za prikaz datuma u korisničkom interfejsu."

#. Description of setting with label #23050 "Activate Teletext"
msgctxt "#36174"
msgid "Enable teletext when watching a live TV stream."
msgstr "Omogućite teletekst prilikom gledanja TV prenosa uživo."

#. Description of setting with label #23055 "Scale Teletext to 4:3"
msgctxt "#36175"
msgid "Scale teletext to 4:3 ratio."
msgstr "Skalirajte teletekst na omjer 4:3."

#. Description of settings category with label #14081 "File lists"
msgctxt "#36176"
msgid "This category contains the settings for how video file lists are handled."
msgstr "Ova kategorija sadrži postavke za način rukovanja listama video datoteka."

#. Description of setting with label #22079 "Default select action"
msgctxt "#36177"
msgid "Toggle between [Choose], [Play] (default), [Show information] and [Queue item].[CR][Choose] will open a context menu to select an item, e.g. show information.[CR][Play] will play videos as defined by the setting 'Default play action'.[CR][Show information] will open the video's information dialog.[CR][Queue item] will append the video to the video playlist."
msgstr "Prebacivanje između [Odaberi], [Reproduciraj] (zadano), [Prikaži informacije] i [Stavka reda čekanja].[CR][Odaberi] će otvoriti kontekstni meni za odabir stavke, npr. prikaži informacije.[CR][Reproduciraj] će reproducirati videozapise kako je definirano postavkom 'Zadana radnja reprodukcije'.[CR][Prikaži informacije] će otvoriti dijalog s informacijama o videozapisu.[CR][Stavka reda čekanja] će dodati videozapis na popis videozapisa za reprodukciju."

#. Description of setting with label #20433 "Extract thumbnails and video information"
msgctxt "#36178"
msgid "Extract metadata information such as codec and aspect ratio from videos."
msgstr "Izvucite metapodatke kao što su kodek i omjer širine i visine iz videozapisa."

#. Description of setting with label #20419 "Replace file names with library titles"
msgctxt "#36179"
msgid "When a file is scanned into the library it will display the metadata title instead of the file name."
msgstr "Kada se datoteka skenira u biblioteku, umjesto imena datoteke će se prikazati naslov metapodataka."

#. Description of setting with label #20433 "Extract thumbnails and video information"
msgctxt "#36180"
msgid "Extract thumbnails to display in library mode."
msgstr "Izdvoji sličice za prikaz u bibliotečkom režimu."

msgctxt "#36181"
msgid "No info available yet."
msgstr "Još nema dostupnih informacija."

#. Description of setting with label #20435 "Combine split video items"
msgctxt "#36182"
msgid "Combines multi-part video files, DVD folders or movie folders, down to a single item in non-library views."
msgstr "Kombinuje višedijelne video datoteke, DVD mape ili mape filmova u jednu stavku u prikazima koji nisu biblioteka."

#. Description of setting with label #20456 "Flatten hierarchy"
msgctxt "#36183"
msgid "Removes the title, genre, etc. nodes from the library view. Selecting a category takes you straight to the title view."
msgstr "Uklanja čvorove naslova, žanra itd. iz prikaza biblioteke. Odabirom kategorije otvara se prikaz naslova."

#. Description of settings category with label #287 "Subtitles"
msgctxt "#36184"
msgid "This category contains the settings for how subtitles are handled."
msgstr "Ova kategorija sadrži postavke za način rukovanja titlovima."

#. Description of setting with label #14089 "Font"
msgctxt "#36185"
msgid "Set the font type to be used for subtitles."
msgstr "Postavite vrstu fonta koja će se koristiti za titlove."

#. Description of setting with label #289 "Size"
msgctxt "#36186"
msgid "Set the font size to be used for subtitles."
msgstr "Postavite veličinu fonta koja će se koristiti za titlove."

#. Description of setting with label #736 "Style"
msgctxt "#36187"
msgid "Set the font style to be used for subtitles."
msgstr "Postavite stil fonta koji će se koristiti za titlove."

#. Description of setting with label #737 "Colour"
msgctxt "#36188"
msgid "Set the font colour to be used for subtitles."
msgstr "Postavite boju fonta koja će se koristiti za titlove."

#. Description of setting with label #735 "Character set"
msgctxt "#36189"
msgid "Set the font character set to be used for subtitles."
msgstr "Postavite skup znakova fonta koji će se koristiti za titlove."

#. Description of setting with label #21368 "Override subtitles fonts"
msgctxt "#36190"
msgid "Override subtitles fonts in subtitle formats such as ASS / SSA."
msgstr "Prebriši fontove titlova u formatima titlova kao što su ASS / SSA."

#. Description of setting with label #21366 "Custom subtitle folder"
msgctxt "#36191"
msgid "Set a custom directory for your subtitles. This can be a file share."
msgstr "Postavite prilagođeni direktorij za svoje titlove. To može biti dijeljenje datoteka."

#. Description of setting with label #21460 "Subtitle location on screen"
msgctxt "#36192"
msgid "Location of subtitles on the screen. [Bottom of video] / [Top of video] When possible the subtitles will be positioned within the video area (depends on video encoding). Please note that some forced positions in the subtitles cannot be changed."
msgstr "Lokacija titlova na ekranu. [Dno videa] / [Vrh videa] Kad god je to moguće, titlovi će biti pozicionirani unutar područja videa (ovisno o kodiranju videa). Imajte na umu da se neke prisilne pozicije u titlovima ne mogu promijeniti."

#. Description of settings category with label #14087 "DVDs"
msgctxt "#36193"
msgid "This category contains the settings for how DVD's, Blu-ray, & CD's are handled."
msgstr "Ova kategorija sadrži postavke za način rukovanja DVD-ovima, Blu-ray i CD-ovima."

#. Description of setting with label #21372 "Forced DVD player region"
msgctxt "#36195"
msgid "Force a region for DVD playback."
msgstr "Forsirajte regiju za reprodukciju DVD-a."

#. Description of setting label #21882 "Attempt to skip introduction before DVD menu"
msgctxt "#36196"
msgid "Attempt to skip \"unskippable\" introductions before DVD menu."
msgstr "Pokušajte preskočiti \"nepreskočive\" uvode prije DVD menija."

msgctxt "#36197"
msgid "No info available yet."
msgstr "Još nema dostupnih informacija."

msgctxt "#36198"
msgid "Select the default movie information source. See the add-ons manager for options."
msgstr "Odaberite zadani izvor informacija o filmu. Pogledajte upravitelj dodataka za opcije."

msgctxt "#36199"
msgid "Select the default TV show information source. See the add-ons manager for options."
msgstr "Odaberite zadani izvor informacija o TV emisiji. Pogledajte upravitelj dodataka za opcije."

msgctxt "#36200"
msgid "Select the default music videos information source. See the add-ons manager for options."
msgstr "Odaberite zadani izvor informacija o muzičkim spotovima. Pogledajte upravitelj dodataka za opcije."

msgctxt "#36201"
msgid "Settings for PVR & Live TV."
msgstr "Postavke za PVR i TV uživo."

msgctxt "#36202"
msgid "This category contains the general settings for the PVR & Live TV."
msgstr "Ova kategorija sadrži opšta podešavanja za PVR i TV uživo."

msgctxt "#36203"
msgid "Enables the \"Personal Video Recorder\" (PVR) features. This requires that at least one PVR add-on is installed."
msgstr "Omogućava funkcije \"Lični video snimač\" (PVR). Za ovo je potrebno instalirati barem jedan PVR dodatak."

#. Description of setting with label #22076 "Default play action"
msgctxt "#36204"
msgid "Toggle between [Ask if resumable] (default), [Resume] and [Play from beginning].[CR][Ask if resumable] will ask whether to play from beginning or to resume (if a resume point is present).[CR][Resume] will automatically resume playback from the last position that you were viewing them. If no resume point is set, playback will automatically start from the beginning.[CR][Play from beginning] will automatically start playback from beginning, ignoring any existing resume positions."
msgstr "Prebacivanje između [Pitaj ako se može nastaviti] (zadano), [Nastavi] i [Reproduciraj od početka]. [CR][Pitaj ako se može nastaviti] će pitati da li da se reprodukcija nastavi od početka ili da se nastavi (ako postoji tačka nastavka). [CR][Nastavi] će automatski nastaviti reprodukciju od posljednje pozicije na kojoj ste je gledali. Ako nije postavljena tačka nastavka, reprodukcija će automatski početi od početka. [CR][Reproduciraj od početka] će automatski pokrenuti reprodukciju od početka, ignorišući sve postojeće pozicije nastavka."

msgctxt "#36205"
msgid "Sort the channels by channel number from the backend, but use local numbering for channels."
msgstr "Sortirajte kanale po broju kanala iz pozadine, ali koristite lokalno numeriranje za kanale."

msgctxt "#36206"
msgid "Use the channel numbering from the backend."
msgstr "Koristite numeriranje kanala iz pozadinskog sistema."

msgctxt "#36207"
msgid "Open the channel manager, which allows modifying the channel order, channel name, icon, etc."
msgstr "Otvorite upravitelj kanala, koji omogućava izmjenu redoslijeda kanala, naziva kanala, ikone itd."

msgctxt "#36208"
msgid "Instruct the backend to search for channels (if supported)."
msgstr "Dajte upute pozadinskom sistemu da traži kanale (ako je podržano)."

msgctxt "#36209"
msgid "Clear the databases for PVR data like channels, groups, reminders and guide. Please note that not all data can be restored from the backend afterwards."
msgstr "Obrišite baze podataka za PVR podatke poput kanala, grupa, podsjetnika i vodiča. Imajte na umu da se ne mogu svi podaci naknadno vratiti iz pozadinskog sistema."

msgctxt "#36210"
msgid "Open the client priorities dialog which allows modifying the priority for enabled PVR clients according to your personal preferences, for instance to order channels client by client. Higher value means higher priority."
msgstr "Otvorite dijalog za prioritete klijenata koji omogućava izmjenu prioriteta za omogućene PVR klijente prema vašim ličnim preferencijama, na primjer, za sortiranje kanala po klijentu. Viša vrijednost znači veći prioritet."

msgctxt "#36211"
msgid "This category contains the settings for PVR channels and channel groups."
msgstr "Ova kategorija sadrži postavke za PVR kanale i grupe kanala."

msgctxt "#36212"
msgid "Display programming information when changing channels, such as the current TV show."
msgstr "Prikaz informacija o programu prilikom promjene kanala, kao što je trenutna TV emisija."

msgctxt "#36213"
msgid "Open the group manager, which allows modification of groups and their respective channels"
msgstr "Otvorite menadžer grupa, koji omogućava modifikaciju grupa i njihovih odgovarajućih kanala"

msgctxt "#36214"
msgid "Preselect the playing channel in windows and dialogs containing channel lists. If enabled and there is a playing channel, the playing channel will be selected when opening a window or dialog containing a channel list. If disabled, the channel previously selected in a window or dialog will be selected when opening a window containing a channel list. "
msgstr "Unaprijed odaberite kanal za reprodukciju u prozorima i dijalozima koji sadrže liste kanala. Ako je omogućeno i postoji kanal za reprodukciju, kanal za reprodukciju će biti odabran prilikom otvaranja prozora ili dijaloga koji sadrži listu kanala. Ako je onemogućeno, kanal prethodno odabran u prozoru ili dijalogu bit će odabran prilikom otvaranja prozora koji sadrži listu kanala. "

#. Description of setting with label #14110 "Long date format"
msgctxt "#36215"
msgid "Choose which long date format is used for displaying the date in the user interface."
msgstr "Odaberite koji će se dugi format datuma koristiti za prikaz datuma u korisničkom interfejsu."

msgctxt "#36216"
msgid "Folder where channel icons are stored."
msgstr "Folder u kojem se nalaze ikone kanala."

msgctxt "#36217"
msgid "Scan for missing channel icons."
msgstr "Skenirajte da li nedostaju ikone kanala."

msgctxt "#36218"
msgid "This category contains the electronic programming guide (EPG) settings."
msgstr "Ova kategorija sadrži postavke elektronskog programskog vodiča (EPG)."

msgctxt "#36219"
msgid "Number of past days to show in the guide and to import from backends."
msgstr "Broj proteklih dana za prikaz u vodiču i za uvoz iz pozadinskih sistema."

msgctxt "#36220"
msgid "Number of future days to show in the guide and to import from backends."
msgstr "Broj budućih dana za prikaz u vodiču i za uvoz iz pozadinskih sistema."

msgctxt "#36221"
msgid "Time between imports of guide data from backends."
msgstr "Vrijeme između uvoza podataka vodiča iz pozadinskih sistema."

msgctxt "#36222"
msgid "Don't import the guide data while playing TV to minimise CPU usage."
msgstr "Nemojte uvoziti podatke vodiča dok reprodukujete TV kako biste smanjili korištenje procesora."

#. Description of setting with label #13438 "Allow Hardware Accelleration with DRM PRIME"
msgctxt "#36223"
msgid "Enable PRIME hardware decoding of video files, used if ffmpeg PRIME hwaccel is available."
msgstr "Omogućite PRIME hardversko dekodiranje video datoteka, koristi se ako je dostupan ffmpeg PRIME hwaccel."

msgctxt "#36224"
msgid "Hide \"No information available\" labels when no guide data is available for a channel."
msgstr "Sakrij oznake \"Nema dostupnih informacija\" kada za kanal nisu dostupni podaci vodiča."

msgctxt "#36225"
msgid "Delete the cached guide data and reimport it from the backend."
msgstr "Izbrišite keširane podatke vodiča i ponovo ih uvezite iz pozadinskog sistema."

msgctxt "#36226"
msgid "This category contains the PVR playback and channel switching settings."
msgstr "Ova kategorija sadrži postavke reprodukcije PVR-a i prebacivanja kanala."

msgctxt "#36227"
msgid "Switch to full screen display when starting playback of channels."
msgstr "Prebacivanje na prikaz preko cijelog ekrana prilikom pokretanja reprodukcije kanala."

#. Description of setting with label #745 "Background Colour"
msgctxt "#36228"
msgid "Set the colour to be used for the subtitle background."
msgstr "Postavite boju koja će se koristiti za pozadinu titlova."

msgctxt "#36229"
msgid "Display signal quality information in the codec information window (if supported by the add-on and backend)."
msgstr "Prikaži informacije o kvaliteti signala u prozoru s informacijama o kodeku (ako to podržava dodatak i pozadinski program)."

#. Description of setting with label #746 "Background Opacity"
msgctxt "#36230"
msgid "Set the subtitle background opacity."
msgstr "Postavite neprozirnost pozadine titlova."

msgctxt "#36231"
msgid "When flipping through channels using channel up/down buttons, channel switches must be confirmed using the OK button."
msgstr "Prilikom prebacivanja kanala pomoću tipki za prethodni/zadnji kanal, promjene kanala moraju se potvrditi tipkom OK."

msgctxt "#36232"
msgid "When pressing channel up or down, the actual channel switch is delayed, allowing the user to flip to a channel number without waiting for each channel switch."
msgstr "Prilikom pritiskanja tipke za odabir kanala gore ili dolje, stvarna promjena kanala se odgađa, što korisniku omogućava prebacivanje na broj kanala bez čekanja na svaku promjenu kanala."

msgctxt "#36233"
msgid "This category contains settings for recordings."
msgstr "Ova kategorija sadrži postavke za snimke."

msgctxt "#36234"
msgid "Duration of instant recordings when pressing the record button. This value will be taken into account if \"Instant recording action\" is set to \"Record for a fixed period of time\""
msgstr "Trajanje trenutnih snimaka pri pritisku na dugme za snimanje. Ova vrijednost će se uzeti u obzir ako je \"Akcija trenutnog snimanja\" postavljena na \"Snimanje u određenom vremenskom periodu\""

msgctxt "#36235"
msgid "Close the on screen display controls after switching channels."
msgstr "Zatvorite kontrole na ekranu nakon prebacivanja kanala."

msgctxt "#36236"
msgid "If set to a value greater than zero last watched time of channels will be stored the given amount of time after start of channel playback. Otherwise the last watched time will be stored immediately at start of channel playback."
msgstr "Ako je vrijednost postavljena na veću od nule, vrijeme posljednjeg gledanja kanala će se pohraniti zadani vremenski period nakon početka reprodukcije kanala. U suprotnom, vrijeme posljednjeg gledanja će se pohraniti odmah na početku reprodukcije kanala."

msgctxt "#36237"
msgid "Additional time to record before the scheduled start time to allow for minor broadcasting changes. Not supported by all add-ons and backends."
msgstr "Dodatno vrijeme za snimanje prije zakazanog vremena početka kako bi se omogućile manje promjene emitiranja. Nije podržano od strane svih dodataka i pozadinskih programa."

msgctxt "#36238"
msgid "Additional time to record after the scheduled end time to allow for minor broadcasting changes. Not supported by all add-ons and backends."
msgstr "Dodatno vrijeme za snimanje nakon zakazanog vremena završetka kako bi se omogućile manje promjene u emitiranju. Nije podržano od strane svih dodataka i pozadinskih programa."

msgctxt "#36239"
msgid "Display a notification when timers are added, finished or removed by the backend."
msgstr "Prikaži obavještenje kada backend doda, završi ili ukloni tajmere."

msgctxt "#36240"
msgid "This category contains the PVR power management settings, such as when to wakeup the PVR backend server."
msgstr "Ova kategorija sadrži postavke upravljanja napajanjem PVR uređaja, kao što je kada probuditi PVR backend server."

msgctxt "#36241"
msgid "Execute the wakeup command below when exiting this application or going into hibernation mode. The timestamp of the next scheduled recording is passed as parameter."
msgstr "Izvršite naredbu za buđenje ispod prilikom izlaska iz ove aplikacije ili prelaska u stanje hibernacije. Vremenska oznaka sljedećeg zakazanog snimanja se prenosi kao parametar."

msgctxt "#36242"
msgid "The command will not be executed when a recording will be started within this timeout."
msgstr "Komanda se neće izvršiti kada snimanje bude započeto unutar ovog vremenskog ograničenja."

msgctxt "#36243"
msgid "The command to execute (cmd [timestamp])."
msgstr "Naredba koju treba izvršiti (cmd [vremenska oznaka])."

msgctxt "#36244"
msgid "Time to subtract from the start time of the next scheduled recording."
msgstr "Vrijeme koje treba oduzeti od vremena početka sljedećeg planiranog snimanja."

msgctxt "#36245"
msgid "Execute the wakeup command every day at the given time."
msgstr "Izvršite naredbu za buđenje svaki dan u zadano vrijeme."

msgctxt "#36246"
msgid "When to execute the daily wakeup command."
msgstr "Kada izvršiti dnevnu komandu za buđenje."

msgctxt "#36247"
msgid "This category contains the parental control settings, if the PVR backend server supports parental controls."
msgstr "Ova kategorija sadrži postavke roditeljskog nadzora, ako PVR backend server podržava roditeljski nadzor."

msgctxt "#36248"
msgid "Asks for a pin code to access parental locked channels. Channels can be marked as locked in the channels editor on the general tab. Parental locked channels can't be played or recorded without entering a pin code, and the guide information is hidden for those channels."
msgstr "Traži PIN kod za pristup kanalima sa roditeljskom kontrolom. Kanali se mogu označiti kao zaključani u uređivaču kanala na kartici Općenito. Kanali sa roditeljskom kontrolom ne mogu se reproducirati ili snimati bez unosa PIN koda, a informacije vodiča za te kanale su skrivene."

msgctxt "#36249"
msgid "Enter a new pin code to unlock parental locked channels."
msgstr "Unesite novi PIN kod da biste otključali kanale s roditeljskom kontrolom."

msgctxt "#36250"
msgid "Ask for the pin code again when trying to access a parental locked channel and the code hasn't been asked for this duration."
msgstr "Ponovo zatražite PIN kod kada pokušavate pristupiti kanalu koji je zaključan s roditeljskim nadzorom, a kod nije tražen u tom periodu."

msgctxt "#36251"
msgid "This category contains the settings for your PVR backend specifically, if supported by the PVR add-on and backend."
msgstr "Ova kategorija sadrži postavke posebno za vaš PVR backend, ako to podržava PVR dodatak i backend."

msgctxt "#36252"
msgid "This option will bring you to any specific settings for your PVR backend, if supported by the PVR add-on and backend."
msgstr "Ova opcija će vas odvesti do bilo kojih specifičnih postavki za vaš PVR backend, ako ih podržava PVR dodatak i backend."

#. Description of settings section with label #2 "Music"
msgctxt "#36253"
msgid "Section that contains settings related to music files and how they are handled."
msgstr "Odjeljak koji sadrži postavke vezane za muzičke datoteke i način na koji se one obrađuju."

msgctxt "#36254"
msgid "Action to perform when pressing the record button. [Record current show] will record the current show from \"now\" to the end of the show. If no TV guide data is currently available a fixed length recording starting \"now\", with the value set for \"Instant recording duration\" will be scheduled. [Record for a fixed period of time] will schedule a fixed length recording starting \"now\", with the value set for \"Instant recording duration\". [Ask what to do] will open a dialogue containing different recording actions to choose from, like \"Record current show\", \"Record next show\" and some fixed duration recordings."
msgstr "Radnja koja se izvodi prilikom pritiska na dugme za snimanje. [Snimi trenutnu emisiju] će snimiti trenutnu emisiju od \"sada\" do kraja emisije. Ako trenutno nisu dostupni podaci TV vodiča, bit će zakazano snimanje fiksne dužine koje počinje \"sada\", s vrijednošću postavljenom za \"Trajanje trenutnog snimanja\". [Snimi u određenom vremenskom periodu] će zakazati snimanje fiksne dužine koje počinje \"sada\", s vrijednošću postavljenom za \"Trajanje trenutnog snimanja\". [Pitaj šta da uradim] će otvoriti dijalog koji sadrži različite radnje snimanja koje možete izabrati, kao što su \"Snimi trenutnu emisiju\", \"Snimi sljedeću emisiju\" i neka snimanja fiksnog trajanja."

#. Description of setting with label #13414 "Show song and album artists"
msgctxt "#36255"
msgid "When enabled, both song and album artists are shown. When disabled, only album artists are shown and artists that appear only on individual songs from an album are excluded."
msgstr "Kada je omogućeno, prikazuju se i izvođači pjesama i albuma. Kada je onemogućeno, prikazuju se samo izvođači albuma, a izvođači koji se pojavljuju samo na pojedinačnim pjesmama s albuma su isključeni."

#. Description of setting with label #20192 "Fetch additional information during updates"
msgctxt "#36256"
msgid "Automatically fetch album and artist information from information providers when adding songs to the library."
msgstr "Automatski preuzmi informacije o albumu i izvođaču od dobavljača informacija prilikom dodavanja pjesama u biblioteku."

#. Description of setting with label #20193 "Default provider for album information"
msgctxt "#36257"
msgid "Select the default album information provider."
msgstr "Odaberite zadanog pružatelja informacija o albumu."

#. Description of setting with label #20194 "Default provider for artist information"
msgctxt "#36258"
msgid "Select the default artist information provider."
msgstr "Odaberite zadanog pružatelja informacija o izvođaču."

#. Description of setting with label #22000 "Update library on startup"
msgctxt "#36259"
msgid "Check for new and removed media files on startup."
msgstr "Provjeri nove i uklonjene medijske datoteke pri pokretanju."

msgctxt "#36260"
msgid "No info available yet."
msgstr "Još nema dostupnih informacija."

#. Description of setting with label #19108 "Refreshrate"
msgctxt "#36261"
msgid "If enabled, this framerate is used for streams we were not able to detect fps."
msgstr "Ako je omogućeno, ova brzina kadrova se koristi za prijenose kod kojih nismo uspjeli detektovati broj kadrova u sekundi."

#. Description of setting with label #20196 "Export music library"
msgctxt "#36262"
msgid "Export parts of the music library to an XML file or NFO files. This will optionally overwrite your current NFO and artwork files."
msgstr "Izvezite dijelove muzičke biblioteke u XML datoteku ili NFO datoteke. Ovo će opcionalno prepisati vaše trenutne NFO i datoteke s grafičkim elementima."

#. Description of setting with label #20197 "Import music library"
msgctxt "#36263"
msgid "Import an XML file into the music library database."
msgstr "Uvezite XML datoteku u bazu podataka muzičke biblioteke."

#. Description of settings category with label #14086 "Playback"
msgctxt "#36264"
msgid "This category contains the settings for how music playback is handled."
msgstr "Ova kategorija sadrži postavke za način na koji se upravlja reprodukcijom muzike."

#. Description of setting with label #489 "Play next song automatically"
msgctxt "#36265"
msgid "Automatically plays the next item in the current folder, for example in \"Files\" view after a track has been played, the next track in the same folder will automatically play."
msgstr "Automatski reproducira sljedeću stavku u trenutnoj mapi, na primjer u prikazu \"Datoteke\" nakon što je pjesma reproducirana, sljedeća pjesma u istoj mapi će se automatski reproducirati."

#. Description of setting with label #14084 "Queue songs on selection"
msgctxt "#36266"
msgid "When songs are selected they are queued instead of playback starting immediately."
msgstr "Kada se pjesme odaberu, one se stavljaju u red čekanja umjesto da se reprodukcija odmah pokrene."

#. Description of setting with label #638 "Volume adjustments"
msgctxt "#36267"
msgid "Read the ReplayGain information encoded in your audio files by a program such as MP3Gain and normalise the sound levels accordingly."
msgstr "Pročitajte informacije o ReplayGainu kodirane u vašim audio datotekama pomoću programa kao što je MP3Gain i shodno tome normalizirajte nivoe zvuka."

#. Description of setting with label #641 "Preamplification level to use for files with encoded ReplayGain information"
msgctxt "#36268"
msgid "Preamplification level to use for files with encoded ReplayGain information."
msgstr ""

#. Description of setting with label #642 "Preamplification level to use for files without encoded ReplayGain information"
msgctxt "#36269"
msgid "Preamplification level to use for files without encoded ReplayGain information."
msgstr ""

#. Description of setting with label #643 "Avoid clipping protection on ReplayGained files"
msgctxt "#36270"
msgid "Play file at lower volume, if necessary, to avoid audio limiting clipping protection. Otherwise clipping protection will be provided by the audioengine in those parts that need it."
msgstr "Reproducirajte datoteku na nižoj jačini zvuka, ako je potrebno, kako biste izbjegli zaštitu od izrezivanja zvuka koja ograničava zvuk. U suprotnom, audio engine će obezbijediti zaštitu od izrezivanja u onim dijelovima kojima je potrebna."

#. Description of setting with label #13314 "Crossfade between songs"
msgctxt "#36271"
msgid "Smoothly fade from one audio track to the next. You can set the amount of overlap from 1-15 seconds."
msgstr "Glatko prelazite s jedne audio trake na drugu. Možete postaviti količinu preklapanja od 1-15 sekundi."

#. Description of setting with label #13400 "Crossfade between songs on the same album"
msgctxt "#36272"
msgid "Allow crossfading to occur when both tracks are from the same album."
msgstr "Dozvoli prelazno pomicanje kada su obje pjesme s istog albuma."

#. Description of setting with label #250 "Visualisation"
msgctxt "#36273"
msgid "Select the visualisation that will be displayed while listening to music."
msgstr "Odaberite vizualizaciju koja će se prikazivati tokom slušanja muzike."

#. Description of setting with label #39125 "Enable tag reading in file view"
msgctxt "#36274"
msgid "When browsing music files in file view read the tags of those not in the music library as you go. This can make large directories slow to display, especially over a network."
msgstr "Prilikom pregledavanja muzičkih datoteka u prikazu datoteka, usput čitajte oznake onih koje nisu u muzičkoj biblioteci. To može usporiti prikazivanje velikih direktorija, posebno preko mreže."

#. Description of setting with label #13307 "Track naming template" for musicfiles.trackformat
msgctxt "#36275"
msgid "Control the way that the names of songs are displayed in the user interface. In order to function properly, tag reading needs to be enabled."
msgstr "Kontrolirajte način na koji se nazivi pjesama prikazuju u korisničkom interfejsu. Da bi ispravno funkcioniralo, čitanje oznaka mora biti omogućeno."

#. unused?
msgctxt "#36276"
msgid "Used for formatting the second column in file lists."
msgstr "Koristi se za formatiranje druge kolone u listama datoteka."

#. Description of setting with label #13307 "Track naming template" in musicfiles.nowplayingtrackformat
msgctxt "#36277"
msgid "Control the way that the names of songs are displayed in the now playing list."
msgstr "Kontrolirajte način na koji se nazivi pjesama prikazuju na listi trenutno reproduciranih pjesama."

#. unused?
msgctxt "#36278"
msgid "Used for formatting the second column in the now playing list."
msgstr "Koristi se za formatiranje druge kolone u listi trenutnog reprodukovanja."

#. Description of setting with label #13307 "Track naming template" in musicfiles.librarytrackformat
msgctxt "#36279"
msgid "Control the way that the names of songs are displayed in library lists."
msgstr "Kontrolirajte način na koji se nazivi pjesama prikazuju u listama biblioteka."

#. unused?
msgctxt "#36280"
msgid "Used for formatting the second column in library lists."
msgstr "Koristi se za formatiranje druge kolone u listama biblioteka."

#. Description of setting with label #14059 "Search for thumbnails on remote shares"
msgctxt "#36281"
msgid "Search for thumbs on remote shares and optical media. This can often slow down the listing of network folders."
msgstr "Pretražite sličice na udaljenim dijeljenim mapama i optičkim medijima. Ovo često može usporiti prikaz mrežnih mapa."

#. Description of settings category with label #620 "Audio CDs"
msgctxt "#36282"
msgid "This category contains the settings for how CDs are handled."
msgstr "Ova kategorija sadrži postavke za način rukovanja CD-ovima."

#. Description of setting with label #227 "Load audio CD information from online service"
msgctxt "#36284"
msgid "Read the information belonging to an audio CD, like song title and artist, from the Internet database gnudb.org."
msgstr "Pročitajte informacije koje pripadaju audio CD-u, kao što su naslov pjesme i izvođač, iz internet baze podataka gnudb.org."

#. Description of setting label #20000 "Saved music folder"
msgctxt "#36285"
msgid "Select the location on your hard drive where ripped tracks will be saved to."
msgstr "Odaberite lokaciju na tvrdom disku gdje će se spremiti ripovane pjesme."

#. Description of setting with label #13307 "Track naming template" in audiocds.trackpathformat
msgctxt "#36286"
msgid "Control how saved music is named from the tags. Tags: [B]%N[/B]: TrackNumber, [B]%S[/B]: DiscNumber, [B]%A[/B]: Artist, [B]%T[/B]: Title, [B]%B[/B]: Album, [B]%G[/B]: Genre, [B]%Y[/B]: Year, [B]%F[/B]: FileName, [B]%D[/B]: Duration, [B]%J[/B]: Date, [B]%R[/B]: Rating, [B]%I[/B]: FileSize."
msgstr "Kontrolirajte kako se sačuvana muzika imenuje iz oznaka. Oznake: [B]%N[/B]: Broj pjesme, [B]%S[/B]: Broj diska, [B]%A[/B]: Izvođač, [B]%T[/B]: Naslov, [B]%B[/B]: Album, [B]%G[/B]: Žanr, [B]%Y[/B]: Godina, [B]%F[/B]: Naziv datoteke, [B]%D[/B]: Trajanje, [B]%J[/B]: Datum, [B]%R[/B]: Ocjena, [B]%I[/B]: Veličina datoteke."

#. Description of setting with label #621 "Encoder"
msgctxt "#36287"
msgid "Select which audio encoder to use when ripping."
msgstr "Odaberite koji audio koder želite koristiti prilikom ripovanja."

#. Description of setting with label #622 "Quality"
msgctxt "#36288"
msgid "Select which quality you want to rip your files."
msgstr "Odaberite kvalitetu u kojoj želite ripati datoteke."

#. Description of setting with label #623 "Bitrate"
msgctxt "#36289"
msgid "Select which bitrate to use for the specified audio encoder for audio compression."
msgstr "Odaberite brzinu prijenosa podataka koju želite koristiti za određeni audio koder za kompresiju zvuka."

#. Description of setting with label #665 "Compression level"
msgctxt "#36290"
msgid "For FLAC define compression level, default 5."
msgstr "Za FLAC definirajte nivo kompresije, podrazumijevano 5."

#. Description of setting with label #14099 "Eject disc when CD ripping is complete"
msgctxt "#36291"
msgid "Auto eject disc after rip is complete."
msgstr "Automatsko izbacivanje diska nakon završetka ripovanja."

#. Description of settings category "Interface -> Startup" with label #14224
msgctxt "#36292"
msgid "This category contains startup settings."
msgstr "Ova kategorija sadrži postavke pokretanja."

#. Description of setting with label #20223 "Artist information folder"
msgctxt "#36293"
msgid "Select the folder where artist information (nfo files and images) should be saved in."
msgstr "Odaberite mapu u koju želite spremiti informacije o izvođaču (nfo datoteke i slike)."

#. Description of setting with label #20228 "Use artist sortname"
msgctxt "#36294"
msgid "When sorting music items by artist use sortname e.g. Parton, Dolly rather than name."
msgstr "Prilikom sortiranja muzičkih elemenata po izvođaču koristite sortname, npr. Parton, Dolly, umjesto imena."

#. Description of setting with label #752 "Opacity"
msgctxt "#36295"
msgid "Set the subtitle opacity."
msgstr "Podesite neprozirnost titlova."

msgctxt "#36296"
msgid "This category contains settings for reminders."
msgstr "Ova kategorija sadrži postavke za podsjetnike."

msgctxt "#36297"
msgid "Choose a time in seconds after which PVR reminder popups will be automatically closed."
msgstr "Odaberite vrijeme u sekundama nakon kojeg će se skočni prozori PVR podsjetnika automatski zatvoriti."

msgctxt "#36298"
msgid "If enabled, a recording for the programme to remind will be scheduled when auto-closing the reminder popup, if supported by the PVR add-on and backend."
msgstr "Ako je omogućeno, snimanje programa za podsjetnik će biti zakazano prilikom automatskog zatvaranja skočnog prozora podsjetnika, ako to podržava PVR dodatak i pozadinski sistem."

#. Description of setting with label #13436 "Adjust display HDR mode"
msgctxt "#36299"
msgid "Allow the HDR mode of the display to be changed to best match the media. When disabled, Kodi applies tonemapping if needed (and if supported on your hardware) to adapt the media to the current HDR mode of the display."
msgstr "Omogućite promjenu HDR načina rada ekrana kako bi najbolje odgovarao mediju. Kada je onemogućeno, Kodi primjenjuje mapiranje tonova ako je potrebno (i ako je podržano na vašem hardveru) kako bi prilagodio medij trenutnom HDR načinu rada ekrana."

#. Description of setting with label #20226 "Movie set information folder"
msgctxt "#36300"
msgid "Select the folder where movie set information (images) are saved locally."
msgstr "Odaberite mapu u koju se lokalno spremaju informacije o filmskom setu (slike)."

msgctxt "#36301"
msgid "No 'Movie set information folder' is configured to store movie set images so they will not be exported. Do you want to proceed?"
msgstr "Nije konfigurisana 'mapa sa informacijama o filmskom setu' za pohranjivanje slika filmskog seta tako da se one neće izvoziti. Želite li nastaviti?"

msgctxt "#36302"
msgid "No info available yet."
msgstr "Još nema dostupnih informacija."

msgctxt "#36303"
msgid "No info available yet."
msgstr "Još nema dostupnih informacija."

#. Description of settings section with label #1 "Pictures"
msgctxt "#36304"
msgid "Section that contains settings related to pictures and how they are handled."
msgstr "Odjeljak koji sadrži postavke vezane za slike i način na koji se one obrađuju."

#. Description of settings category with label #14081 "File lists"
msgctxt "#36305"
msgid "This category contains the settings for how picture file lists are handled."
msgstr "Ova kategorija sadrži postavke za način rukovanja listama slikovnih datoteka."

msgctxt "#36306"
msgid "If not using backend channel numbers then start all groups channel numbers from 1."
msgstr "Ako ne koristite brojeve kanala u pozadini, onda počnite s brojevima kanala svih grupa od 1."

#. Description of setting with label #13360 "Automatically generate thumbnails"
msgctxt "#36307"
msgid "Automatically generate picture thumbnails when entering picture folder."
msgstr "Automatsko generiranje sličica slika pri ulasku u mapu slika."

#. Description of setting with label #20472 "Show all performers for music videos"
msgctxt "#36308"
msgid "When enabled, shows all performers in the artist list for music videos, not just the main artist"
msgstr "Kada je omogućeno, prikazuje sve izvođače na listi izvođača za muzičke spotove, ne samo glavnog izvođača"

#. Description of setting with label #22022 "Show video files in listings"
msgctxt "#36309"
msgid "Show videos in picture file lists."
msgstr "Prikaži video zapise u listama slikovnih datoteka."

#. Description of setting with label #169 "Resolution"
msgctxt "#36310"
msgid "No info available yet."
msgstr "Još nema dostupnih informacija."

#. Description of settings category with label #108 "Slideshow"
msgctxt "#36311"
msgid "This category contains the settings for how the picture slideshow is handled."
msgstr "Ova kategorija sadrži postavke za način na koji se upravlja projekcijom slajdova slika."

#. Description of setting with label #12378 "Amount of time to display each image"
msgctxt "#36312"
msgid "Select the amount of time that each image is displayed in a slideshow."
msgstr "Odaberite vrijeme prikazivanja svake slike u slideshowu."

#. Description of setting with label #12379 "Use pan and zoom effects"
msgctxt "#36313"
msgid "Images in a slideshow will pan and zoom while displayed."
msgstr "Slike u slajdšouu će se pomicati i zumirati tokom prikazivanja."

#. Description of setting with label #13319 "Randomise"
msgctxt "#36314"
msgid "View slideshow images in a random order."
msgstr "Prikaz slika u slajdšou nasumičnim redoslijedom."

#. Description of settings section with label #8 "Weather"
msgctxt "#36315"
msgid "Section that contains weather related settings."
msgstr "Odjeljak koji sadrži postavke vezane za vremenske prilike."

#. Description of settings category with label #16000 "General"
msgctxt "#36316"
msgid "This category contains the settings for how the weather service is handled."
msgstr "Ova kategorija sadrži postavke za način na koji se upravlja meteorološkom uslugom."

#. Description of settings category with label #0 "Locations"
msgctxt "#36317"
msgid "Select up to three locations for which the weather can be displayed."
msgstr "Odaberite do tri lokacije za koje se može prikazati vremenska prognoza."

#. Description of setting with label #24029 "Service for weather information"
msgctxt "#36318"
msgid "Specify the default weather information source. See the add-ons manager for options."
msgstr "Odredite zadani izvor informacija o vremenu. Pogledajte upravitelj dodataka za opcije."

#. Description of settings section with label #14036  "Services"
msgctxt "#36319"
msgid "Section containing settings for how services are handled."
msgstr "Odjeljak koji sadrži postavke za način rukovanja uslugama."

#. Description of settings category with label #16000 "General"
msgctxt "#36320"
msgid "This category contains the settings used for all services."
msgstr "Ova kategorija sadrži postavke koje se koriste za sve usluge."

#. Description of setting with label #1271 "Device name"
msgctxt "#36321"
msgid "The name to display for this device when using various network services."
msgstr "Naziv koji će se prikazivati za ovaj uređaj prilikom korištenja različitih mrežnih usluga."

#. Description of settings category with label #20187 "UPnP/DLNA"
msgctxt "#36322"
msgid "This category contains the settings for how the UPnP service is handled. UPnP is also called DLNA on most consumer electronics."
msgstr "Ova kategorija sadrži postavke za način rukovanja UPnP uslugom. UPnP se na većini potrošačke elektronike naziva i DLNA."

#. Description of setting with label #21360 "Share my libraries"
msgctxt "#36323"
msgid "Enables the UPnP server. This allows you to stream media in your libraries to a UPnP client."
msgstr "Omogućava UPnP server. Ovo vam omogućava da strimujete medije iz vaših biblioteka na UPnP klijent."

#. Description of setting with label #20188 "Announce library updates"
msgctxt "#36324"
msgid "When a manual or automatic library update occurs, notify UPnP clients."
msgstr "Obavijesti UPnP klijente kada dođe do ručnog ili automatskog ažuriranja biblioteke."

#. Description of setting with label #21881 "Allow playback control via UPnP"
msgctxt "#36325"
msgid "Enable the UPnP client. This allows you to stream media from any UPnP server with a control point and control playback from that server."
msgstr "Omogućite UPnP klijent. Ovo vam omogućava strimovanje medija sa bilo kojeg UPnP servera sa kontrolnom tačkom i kontrolu reprodukcije sa tog servera."

#. Description of setting with label #21361 "Look for remote UPnP players"
msgctxt "#36326"
msgid "Enable the UPnP control point. This allows you to stream media to any UPnP client and control its playback."
msgstr "Omogućite UPnP kontrolnu tačku. Ovo vam omogućava da strimujete medije na bilo koji UPnP klijent i kontrolišete njihovu reprodukciju."

#. Description of settings category with label #20187 "Control"
msgctxt "#36327"
msgid "This category contains the settings for how the web server service and the application control service is handled."
msgstr "Ova kategorija sadrži postavke za način na koji se rukuje uslugom web servera i uslugom kontrole aplikacija."

#. Description of setting with label #263 "Allow remote control via HTTP"
msgctxt "#36328"
msgid "Enable remote users to control this application through the built-in web server. Never expose the web server port to the Internet."
msgstr "Omogućite udaljenim korisnicima kontrolu nad ovom aplikacijom putem ugrađenog web servera. Nikada ne izlažite port web servera internetu."

#. Description of setting with label #730 "Port"
msgctxt "#36329"
msgid "Define the web server port."
msgstr "Definišite port web servera."

#. Description of setting with label #1048 "Username"
msgctxt "#36330"
msgid "Define the web server username. Must be set when authentication is enabled."
msgstr "Definirajte korisničko ime web servera. Mora se postaviti kada je omogućena autentifikacija."

#. Description of setting with label #1048 "Password"
msgctxt "#36331"
msgid "Define the web server password. Must be set when authentication is enabled."
msgstr "Definišite lozinku web servera. Mora se postaviti kada je omogućena autentifikacija."

#. Description of setting with label #199 "Web interface"
msgctxt "#36332"
msgid "Select between web interfaces installed via the add-on manager."
msgstr "Izaberite između web interfejsa instaliranih putem upravitelja dodataka."

#. Description of settings category with label #790 "Remote Control"
msgctxt "#36333"
msgid "This category contains the settings for how the remote control service is handled."
msgstr "Ova kategorija sadrži postavke za način rukovanja uslugom daljinskog upravljanja."

#. Description of setting with label #791 "Allow remote control from programs on this system"
msgctxt "#36334"
msgid "Allow programs on this device to control this application via the JSON-RPC over WebSocket, JSON-RPC over TCP, or EventServer protocol, without authentication."
msgstr "Dozvolite programima na ovom uređaju da kontrolišu ovu aplikaciju putem JSON-RPC preko WebSocket-a, JSON-RPC preko TCP-a ili EventServer protokola, bez autentifikacije."

#. Description of setting with label #792 "Port"
msgctxt "#36335"
msgid "Define the remote control port."
msgstr "Definišite port za daljinsko upravljanje."

#. Description of setting with label #793 "Port range"
msgctxt "#36336"
msgid "Define the remote control port range."
msgstr "Definišite opseg portova za daljinsko upravljanje."

#. Description of setting with label #797 "Maximum number of clients"
msgctxt "#36337"
msgid "Define the maximum number of clients that can connect."
msgstr "Definišite maksimalan broj klijenata koji se mogu povezati."

#. Description of setting with label #794 "Allow remote control from programs on other systems"
msgctxt "#36338"
msgid "Allow programs on the network to control this application via the JSON-RPC over WebSocket, JSON-RPC over TCP, or EventServer protocol, without authentication. It allows anyone with access to the network to completely control this application and, therefore, this device. Never expose these interfaces to the Internet."
msgstr "Dozvolite programima na mreži da kontrolišu ovu aplikaciju putem JSON-RPC preko WebSocket-a, JSON-RPC preko TCP-a ili EventServer protokola, bez autentifikacije. To omogućava bilo kome ko ima pristup mreži da u potpunosti kontroliše ovu aplikaciju i, samim tim, ovaj uređaj. Nikada ne izlažite ove interfejse internetu."

#. Description of setting with label #795 "Initial repeat delay (ms)"
msgctxt "#36339"
msgid "Initial repeat delay (ms)."
msgstr "Početno kašnjenje ponavljanja (ms)."

#. Description of setting with label #796 "Continuous repeat delay (ms)"
msgctxt "#36340"
msgid "Continuous repeat delay (ms)."
msgstr "Neprekidno kašnjenje ponavljanja (ms)."

#. Description of settings category with label #1259 "Zeroconf"
msgctxt "#36341"
msgid "This category contains the settings for how the Zeroconf network discovery service is handled, required for AirPlay."
msgstr "Ova kategorija sadrži postavke za način rukovanja uslugom otkrivanja mreže Zeroconf, potrebnom za AirPlay."

#. Description of setting with label #1260 "Announce services to other systems"
msgctxt "#36342"
msgid "Allows applications on the network to discover enabled services via Zeroconf."
msgstr "Omogućava aplikacijama na mreži da otkriju omogućene usluge putem Zeroconfa."

#. Description of setting with label #1270 "Enable AirPlay support"
msgctxt "#36343"
msgid "If enabled, the content from other AirPlay devices or applications can be received."
msgstr "Ako je omogućeno, moguće je primati sadržaj s drugih AirPlay uređaja ili aplikacija."

#. Description of setting with label #1272 "Use password protection"
msgctxt "#36344"
msgid "Enable AirPlay password protection."
msgstr "Omogućite zaštitu lozinkom za AirPlay."

#. Description of setting with label #733 "Password"
msgctxt "#36345"
msgid "Sets the AirPlay password."
msgstr "Postavlja lozinku za AirPlay."

#. Description of settings category with label #1200 "SMB Client"
msgctxt "#36346"
msgid "This category contains the settings for how the SMB client (Samba) service is handled."
msgstr "Ova kategorija sadrži postavke za način rukovanja SMB klijentskom (Samba) uslugom."

#. Description of setting with label #1207 "WINS server"
msgctxt "#36347"
msgid "If a WINS server is running on the network, enter its IP address here. Otherwise, leave blank."
msgstr "Ako WINS server radi na mreži, unesite njegovu IP adresu ovdje. U suprotnom, ostavite prazno."

#. Description of setting with label #1202 "Workgroup"
msgctxt "#36348"
msgid "If a WINS server is running on the network, enter its workgroup name here. Otherwise, leave blank."
msgstr "Ako WINS server radi na mreži, ovdje unesite naziv njegove radne grupe. U suprotnom, ostavite prazno."

#. Description of settings section with label #13000 "System"
msgctxt "#36349"
msgid "Section that contains the system related settings for the device this application is installed on."
msgstr "Odjeljak koji sadrži postavke vezane za sistem za uređaj na kojem je ova aplikacija instalirana."

#. Description of setting with label #13026 "Try to wake remote servers on access"
msgctxt "#36350"
msgid "Automatically send Wake-on-LAN to server(s) right before trying to access shared files or services."
msgstr "Automatski pošalji Wake-on-LAN na server(e) neposredno prije pokušaja pristupa dijeljenim datotekama ili uslugama."

#. Description of setting with label #21373 "Display Mode"
msgctxt "#36351"
msgid "Changes the way this application is displayed on the selected screen. Either in a window or fullscreen."
msgstr "Mijenja način na koji se ova aplikacija prikazuje na odabranom ekranu. Ili u prozoru ili preko cijelog ekrana."

#. Description of setting with label #169 "Resolution"
msgctxt "#36352"
msgid "Changes the resolution that the user interface is displayed in."
msgstr "Mijenja rezoluciju u kojoj se prikazuje korisnički interfejs."

#. Description of setting with label #243 "Refresh Rate"
msgctxt "#36353"
msgid "Changes the refresh rate that the user interface is displayed in."
msgstr "Mijenja brzinu osvježavanja kojom se prikazuje korisnički interfejs."

#. Description of setting with label #14083 "Use fullscreen window"
msgctxt "#36354"
msgid "If enabled, fullscreen mode will be applied by using a window instead of a real fullscreen mode. The main benefit is for multi-screen configurations, so that other applications can be used in parallel more easily. This uses more resources so playback may be less smooth."
msgstr "Ako je omogućeno, režim cijelog ekrana će se primjenjivati korištenjem prozora umjesto pravog režima cijelog ekrana. Glavna prednost je u konfiguracijama više ekrana, tako da se druge aplikacije mogu lakše koristiti paralelno. Ovo koristi više resursa, pa reprodukcija može biti manje glatka."

#. Description of setting with label #13130 "Blank other displays"
msgctxt "#36355"
msgid "In a multi-screen configuration, the screens not displaying this application are blacked out."
msgstr "U konfiguraciji s više ekrana, ekrani koji ne prikazuju ovu aplikaciju su zatamnjeni."

#. Description of settings category with label #1201 "NFS Client"
msgctxt "#36356"
msgid "This category contains the settings for how the NFS client is handled."
msgstr "Ova kategorija sadrži postavke za način rukovanja NFS klijentom."

# empty string with id 36356
#. Description of setting with label #214 "Video calibration..."
msgctxt "#36357"
msgid "Calibrate the user interface by adjusting the overscan. Use this tool if the image being displayed is too large or small for your display."
msgstr "Kalibrirajte korisnički interfejs podešavanjem prekoračenja okvira. Koristite ovaj alat ako je prikazana slika prevelika ili premala za vaš ekran."

msgctxt "#36358"
msgid "Allow using channel numbering from multiple backends. Note that the All channels group can contain multiple of the same channel number if using this option. This means that jump to channel number may not work correctly for the All channels group."
msgstr "Omogućite korištenje numeriranja kanala iz više pozadinskih sistema. Imajte na umu da grupa Svi kanali može sadržavati više istih brojeva kanala ako koristite ovu opciju. To znači da prelazak na broj kanala možda neće ispravno funkcionirati za grupu Svi kanali."

#. Description of setting with label #36042 "Use limited colour range (16-235)"
msgctxt "#36359"
msgid "Use limited colour range (16-235) instead of full colour range (0-255). Limited range should be used if your display is a regular HDMI TV and doesn't have a PC or other mode to display full range colour, however if your display is a PC monitor then leave this disabled to get proper blacks."
msgstr "Koristite ograničeni raspon boja (16-235) umjesto punog raspona boja (0-255). Ograničeni raspon treba koristiti ako je vaš ekran običan HDMI TV i nema PC ili neki drugi način rada za prikaz punog raspona boja, međutim, ako je vaš ekran PC monitor, onda ostavite ovu opciju onemogućenu da biste dobili odgovarajuće crne nijanse."

#. Description of settings category with label #772 "Audio"
msgctxt "#36360"
msgid "This category contains the settings for how audio output is handled."
msgstr "Ova kategorija sadrži postavke za način rukovanja audio izlazom."

#. Description of setting with label #337 "Output configuration"
msgctxt "#36361"
msgid "Select how the properties of the audio output are set: [Fixed] Output properties are set to the specified sampling rate & speaker configuration at all times; [Best Match] Output properties are set to always be as close a match to the source properties as possible; [Optimized] Output properties are set at the start of playback and will not change if the properties of the source change."
msgstr "Odaberite kako se postavljaju svojstva audio izlaza: [Fiksno] Svojstva izlaza se uvijek postavljaju na navedenu brzinu uzorkovanja i konfiguraciju zvučnika; [Najbolje podudaranje] Svojstva izlaza se postavljaju tako da uvijek budu što bliža svojstvima izvora; [Optimizirano] Svojstva izlaza se postavljaju na početku reprodukcije i neće se promijeniti ako se promijene svojstva izvora."

#. Description of setting with label #34100 "Number of channels"
msgctxt "#36362"
msgid "Select the number of channels supported by the audio connection, or the number of speakers if connected by analogue connections. This setting does not apply to passthrough audio. Note: S/PDIF supports 2.0 channels only but can still output multichannel audio using a format supported by passthrough."
msgstr "Odaberite broj kanala koje podržava audio priključak ili broj zvučnika ako su povezani analognim priključcima. Ova postavka se ne odnosi na prolazni audio. Napomena: S/PDIF podržava samo 2.0 kanale, ali i dalje može reproducirati višekanalni audio koristeći format koji podržava prolazni zvuk."

msgctxt "#36363"
msgid "Boost AC3 streams that have been downmixed to 2 channels."
msgstr "Pojačajte AC3 prijenose koji su svedeni na 2 kanala."

#. Description of setting with label #252 "Stereo upmix"
msgctxt "#36364"
msgid "Select to enable upmixing of 2 channel audio to the number of audio channels specified by the channel configuration."
msgstr "Odaberite da biste omogućili miksovanje dvokanalnog zvuka na broj audio kanala određen konfiguracijom kanala."

#. Description of setting with label #364 "Dolby Digital (AC3) capable receiver"
msgctxt "#36365"
msgid "Select this option if your receiver is capable of decoding Dolby Digital (AC3) streams."
msgstr "Odaberite ovu opciju ako vaš prijemnik može dekodirati Dolby Digital (AC3) prijenose."

#. Description of setting with label #254 "DTS capable receiver"
msgctxt "#36366"
msgid "Select this option if your receiver is capable of decoding DTS streams."
msgstr "Odaberite ovu opciju ako vaš prijemnik može dekodirati DTS prijenose."

msgctxt "#36367"
msgid "Select the maximum number of audio channels / speakers available for decoded audio. If optical / coax digital outputs are used, this must be set to 2.0"
msgstr "Odaberite maksimalan broj audio kanala / zvučnika dostupnih za dekodirani zvuk. Ako se koriste optički / koaksijalni digitalni izlazi, ovo mora biti postavljeno na 2.0"

#. Description of setting with label #348 "Enable passthrough"
msgctxt "#36368"
msgid "Select to allow passthrough audio for playback of compressed audio such as Dolby Digital (AC3), DTS, etc. The Client of the AudioEngine, for example Videoplayer, might decide to decode the audio stream under certain conditions. In Videoplayer case, passthrough won't be used for live streams and when you sync playback to display."
msgstr "Odaberite da biste omogućili prolaz zvuka za reprodukciju komprimiranog zvuka kao što je Dolby Digital (AC3), DTS itd. Klijent AudioEngine-a, na primjer Videoplayer, može odlučiti dekodirati audio prijenos pod određenim uvjetima. U slučaju Videoplayera, prolaz se neće koristiti za prijenose uživo i kada sinhronizirate reprodukciju s prikazom."

#. Description of setting with label #349 "TrueHD capable receiver"
msgctxt "#36369"
msgid "Select this option if your receiver is capable of decoding TrueHD streams."
msgstr "Odaberite ovu opciju ako vaš prijemnik može dekodirati TrueHD prijenose."

#. Description of setting with label #347 "DTS-HD capable receiver"
msgctxt "#36370"
msgid "Select this option if your receiver is capable of decoding DTS-HD streams."
msgstr "Odaberite ovu opciju ako vaš prijemnik može dekodirati DTS-HD prijenose."

#. Description of setting with label #545 "Audio output device"
msgctxt "#36371"
msgid "Select the device to be used for playback of audio that has been decoded such as mp3."
msgstr "Odaberite uređaj koji će se koristiti za reprodukciju dekodiranog zvuka, kao što je mp3."

#. Description of setting with label #546 "Passthrough output device"
msgctxt "#36372"
msgid "Select the device to be used for playback of encoded formats, these are any of the formats below in the capable receiver options."
msgstr "Odaberite uređaj koji će se koristiti za reprodukciju kodiranih formata; to su bilo koji od formata navedenih u opcijama kompatibilnih prijemnika."

#. Description of setting with label #34120 "Play GUI sounds"
msgctxt "#36373"
msgid "Configure how interface sounds are handled, such as menu navigation and important notifications."
msgstr "Konfigurišite kako se obrađuju zvukovi interfejsa, kao što su navigacija kroz menije i važna obavještenja."

#. Description of settings category with label #15087 "Input"
msgctxt "#36374"
msgid "This category contains the settings for how input devices are handled."
msgstr "Ova kategorija sadrži postavke za način rukovanja ulaznim uređajima."

#. Description of setting with label #35000 "Peripherals"
msgctxt "#36375"
msgid "Configure any attached peripheral devices."
msgstr "Konfigurišite sve priključene periferne uređaje."

#. Description of setting with label #21449 "Remote control sends keyboard presses"
msgctxt "#36376"
msgid "When activated, your keyboard arrows will move the selection on the virtual keyboard. When deactivated, they will move the cursor from your text."
msgstr "Kada su aktivirane, strelice na tastaturi će pomicati odabir na virtuelnoj tastaturi. Kada su deaktivirane, pomicat će kursor s vašeg teksta."

#. Description of setting with label #21369 "Enable mouse and Touch Screen support"
msgctxt "#36377"
msgid "Use a mouse or touch screen device to control the interface. Note: Disabling will cause you to lose control over this application when no keyboard or remote is present."
msgstr "Koristite miš ili ekran osjetljiv na dodir za upravljanje interfejsom. Napomena: Onemogućavanje će uzrokovati gubitak kontrole nad ovom aplikacijom kada nema tastature ili daljinskog upravljača."

#. Description of setting with label #35100 "Enable controller support"
msgctxt "#36378"
msgid "Use a game controller to control the interface."
msgstr "Koristite kontroler za igru za kontrolu interfejsa."

#. Description of settings category with label #798 Internet access
msgctxt "#36379"
msgid "This category contains the settings for how Internet access is handled. The default web interface can also be selected here."
msgstr "Ova kategorija sadrži postavke za način na koji se rukuje pristupom internetu. Ovdje se također može odabrati zadani web interfejs."

#. Description of setting with label #708 "Use proxy server"
msgctxt "#36380"
msgid "If your Internet connection uses a proxy server, configure it here."
msgstr "Ako vaša internet veza koristi proxy server, konfigurirajte ga ovdje."

#. Description of setting with label #1180 "Proxy type"
msgctxt "#36381"
msgid "Configure which proxy type is used."
msgstr "Konfigurišite koji tip proxyja se koristi."

#. Description of setting with label #706 "Server"
msgctxt "#36382"
msgid "Configure the proxy server address."
msgstr "Konfigurišite adresu proxy servera."

#. Description of setting with label #730 "Port"
msgctxt "#36383"
msgid "Configure the proxy server port."
msgstr "Konfigurišite port proxy servera."

#. Description of setting with label #1048 "Username"
msgctxt "#36384"
msgid "Configure the proxy server username."
msgstr "Konfigurišite korisničko ime proxy servera."

#. Description of setting with label #733 "Password"
msgctxt "#36385"
msgid "Configure the proxy server password."
msgstr "Konfigurišite lozinku proxy servera."

#. Description of setting with label #14041 "Internet connection bandwidth limitation"
msgctxt "#36386"
msgid "If your Internet connection has limited bandwidth available, use this setting to keep bandwidth usage by this application within defined limits."
msgstr "Ako vaša internetska veza ima ograničen propusni opseg, koristite ovu postavku kako biste korištenje propusnog opsega od strane ove aplikacije održali unutar definiranih ograničenja."

#. Description of settings category with label #14095 "Power saving"
msgctxt "#36387"
msgid "This category contains the settings for power saving."
msgstr "Ova kategorija sadrži postavke za uštedu energije."

#. Description of setting with label #1450 "Put display to sleep when idle"
msgctxt "#36388"
msgid "Turn off display when idle. Useful for TVs that turn off when there is no display signal detected."
msgstr "Isključi ekran kada je neaktivan. Korisno za televizore koji se isključuju kada nije detektovan signal ekrana."

#. Description of setting with label #357 "Shutdown function timer"
msgctxt "#36389"
msgid "Set the time to wait for any activity to occur before shutting down."
msgstr "Podesite vrijeme čekanja da se izvrši bilo kakva aktivnost prije isključivanja."

#. Description of setting with label #13008 "Shutdown function"
msgctxt "#36390"
msgid "Define what action to perform when the shutdown function timer lapsed."
msgstr "Definišite koja se radnja izvršava kada istekne tajmer funkcije isključivanja."

#. Description of settings category with label #14092 "Logging"
msgctxt "#36391"
msgid "This category contains the settings for enabling event and debug logging. You can also enable component-specific debug logging in order to help troubleshoot related issues in more detail."
msgstr "Ova kategorija sadrži postavke za omogućavanje zapisivanja događaja i otklanjanja grešaka. Također možete omogućiti zapisivanje grešaka specifično za komponentu kako biste detaljnije riješili probleme s kojima se susrećemo."

#. Description of setting with label #20191 "Enable debug logging"
msgctxt "#36392"
msgid "Turn debug logging on or off. Useful for troubleshooting."
msgstr "Uključite ili isključite zapisivanje grešaka u dnevniku. Korisno za rješavanje problema."

#. Description of setting with label #20004 "Screenshot folder"
msgctxt "#36393"
msgid "Select the folder where screenshots should be saved in."
msgstr "Odaberite mapu u koju treba spremiti snimke ekrana."

#. Description of setting with label #666 "Enable component-specific logging"
msgctxt "#36394"
msgid "Enables verbose messages from additional libraries to be included in the debug log."
msgstr "Omogućava uključivanje detaljnih poruka iz dodatnih biblioteka u dnevnik otklanjanja grešaka."

#. Description of settings category with label #12360 "Master lock"
msgctxt "#36395"
msgid "This category contains the settings for how the master lock function is handled."
msgstr "Ova kategorija sadrži postavke za način rukovanja funkcijom glavnog zaključavanja."

#. Description of setting with label #20100 "Master lock code and settings"
msgctxt "#36396"
msgid "Here you can enable or disable master lock and define the PIN code used to unlock it. You can also specify which areas of the application would need a PIN to access them."
msgstr "Ovdje možete omogućiti ili onemogućiti glavnu bravu i definirati PIN kod koji se koristi za otključavanje. Također možete odrediti kojim područjima aplikacije je potreban PIN za pristup."

#. Description of setting with label #20076 "Ask for master lock code on startup"
msgctxt "#36397"
msgid "If enabled, the master lock code is required to unlock this application on startup."
msgstr "Ako je omogućeno, glavni kod za otključavanje je potreban za otključavanje ove aplikacije prilikom pokretanja."

#. Description of setting with label #20076 "Max Retries"
msgctxt "#36398"
msgid "Define the maximum number of retries before this application is closed down."
msgstr "Definirajte maksimalan broj ponovnih pokušaja prije nego što se ova aplikacija zatvori."

#. Description of settings category with label #439 "Cache"
msgctxt "#36399"
msgid "This category contains the settings for how the cache function is handled."
msgstr "Ova kategorija sadrži postavke za način rukovanja funkcijom keširanja."

#. Description of settings category with label #14025 "Video/Audio/DVD cache - Hard disk"
msgctxt "#36400"
msgid "Enable cache for playback of video, audio or DVDs from hard disk."
msgstr "Omogućite keš memoriju za reprodukciju videa, zvuka ili DVD-ova sa tvrdog diska."

#. Description of settings category with label #14026 "Video cache - DVD-ROM"
msgctxt "#36401"
msgid "Enable cache for playback of video from DVD-ROM."
msgstr "Omogućite keš memoriju za reprodukciju videa sa DVD-ROM-a."

#. Description of settings category with label #14027 "Video cache - Local Network"
msgctxt "#36402"
msgid "Enable cache for video playback from local network."
msgstr "Omogući keš memoriju za reprodukciju videa s lokalne mreže."

#. Description of settings category with label #14028 "Video cache - Internet"
msgctxt "#36403"
msgid "Enable cache for video playback from Internet."
msgstr "Omogućite keš memoriju za reprodukciju videa s interneta."

#. Description of settings category with label #14030 "Audio cache - DVD-ROM"
msgctxt "#36404"
msgid "Enable cache for playback of audio from DVD-ROM."
msgstr "Omogućite keš memoriju za reprodukciju zvuka sa DVD-ROM-a."

#. Description of settings category with label #14031 "Audio cache - Local Network"
msgctxt "#36405"
msgid "Enable cache for audio playback from local network."
msgstr "Omogući keš memoriju za reprodukciju zvuka s lokalne mreže."

#. Description of settings category with label #14032 "Audio cache - Internet"
msgctxt "#36406"
msgid "Enable cache for audio playback from Internet."
msgstr "Omogući keš memoriju za reprodukciju zvuka s interneta."

#. Description of setting with label #14034 "DVD cache - DVD-ROM"
msgctxt "#36407"
msgid "Enable cache for playback of DVD from DVD-ROM."
msgstr "Omogući keš memoriju za reprodukciju DVD-a sa DVD-ROM-a."

#. Description of setting with label #14037 "DVD cache - Local Network"
msgctxt "#36408"
msgid "Enable cache for DVD playback from local network."
msgstr "Omogući keš memoriju za reprodukciju DVD-a s lokalne mreže."

#. Description of setting with label #14060 "Unknown type cache - Internet"
msgctxt "#36409"
msgid "Enable cache of unknown types from Internet."
msgstr "Omogući keširanje nepoznatih tipova sa interneta."

msgctxt "#36410"
msgid "No info available yet."
msgstr "Još nema dostupnih informacija."

msgctxt "#36411"
msgid "No info available yet."
msgstr "Još nema dostupnih informacija."

msgctxt "#36412"
msgid "No info available yet."
msgstr "Još nema dostupnih informacija."

msgctxt "#36413"
msgid "No info available yet."
msgstr "Još nema dostupnih informacija."

msgctxt "#36414"
msgid "No info available yet."
msgstr "Još nema dostupnih informacija."

msgctxt "#36415"
msgid "No info available yet."
msgstr "Još nema dostupnih informacija."

#. Description of setting with label #1451 "Restart playback after waking up"
msgctxt "#36416"
msgid "Restarts playback of the last played file when woken up."
msgstr ""

# empty strings from id 36416 to 36417
#. Description of setting with label #295 "Low latency mode"
msgctxt "#36418"
msgid ""
"Reduces audio processing latency. Improves playback start, unpause and seek (the audio returns sooner).\n"
"You can disable this setting if you experience audio issues."
msgstr ""

#. Description of setting with label #21417 "Settings"
msgctxt "#36419"
msgid "Define locations used for retrieving weather information."
msgstr "Definirajte lokacije koje se koriste za preuzimanje informacija o vremenu."

#. Description of setting with label #20222 "Look for external subtitles"
msgctxt "#36420"
msgid "Look for external subtitles for videos provided by the UPnP server. This can cause extensive CPU, filesystem and network load."
msgstr "Potražite eksterne titlove za videozapise koje pruža UPnP server. To može uzrokovati veliko opterećenje procesora, datotečnog sistema i mreže."

#. Description of setting with label #13437 "Prefer VDPAU Video Mixer"
msgctxt "#36421"
msgid "Bypassing VDPAU mixer saves resources on low power systems but slightly reduces picture quality."
msgstr "Zaobilaženje VDPAU miksera štedi resurse na sistemima sa niskom potrošnjom energije, ali neznatno smanjuje kvalitet slike."

msgctxt "#36422"
msgid "Update official add-ons from"
msgstr "Ažurirajte službene dodatke od"

#. Description of setting with label #36422 "Update official add-ons from"
msgctxt "#36423"
msgid "By default, add-ons from official repositories will be prevented from being auto-updated from private repositories. For cases such as updating from an add-ons beta repository this option can be switched to [Any repositories] (bear in mind this is a less secure option and enabling it could cause incompatibility and crashes)."
msgstr "Prema zadanim postavkama, dodaci iz službenih repozitorija bit će spriječeni da se automatski ažuriraju iz privatnih repozitorija. U slučajevima kao što je ažuriranje iz beta repozitorija dodataka, ova opcija se može prebaciti na [Bilo koji repozitorij] (imajte na umu da je ovo manje sigurna opcija i da njeno omogućavanje može uzrokovati nekompatibilnost i pad sistema)."

msgctxt "#36424"
msgid "Select what will happen when an item is selected in the guide: [Show context menu] Will trigger the context menu from where you can choose further actions; [Switch to channel] Will instantly tune to the related channel; [Show information] Will display a detailed information with plot and further options; [Record] Will create a recording timer for the selected item. [\"Smart select\"] The action is choosen dynamically, depending on whether the event is in the past, now or in the future."
msgstr "Odaberite šta će se dogoditi kada se stavka odabere u vodiču: [Prikaži kontekstni meni] Pokrenut će se kontekstni meni iz kojeg možete odabrati daljnje radnje; [Prebaci na kanal] Trenutno će se prebaciti na povezani kanal; [Prikaži informacije] Prikazat će detaljne informacije s radnjom i daljnjim opcijama; [Snimi] Kreirat će tajmer snimanja za odabranu stavku. [\"Pametni odabir\"] Radnja se bira dinamički, ovisno o tome je li događaj u prošlosti, sada ili u budućnosti."

msgctxt "#36425"
msgid "Show context menu"
msgstr "Prikaži kontekstni meni"

msgctxt "#36426"
msgid "Switch to channel"
msgstr "Prebaci na kanal"

msgctxt "#36427"
msgid "Show information"
msgstr "Prikaži informacije"

msgctxt "#36428"
msgid "Record"
msgstr "Snimi"

#. Description of setting with label #667 "Enable Dolby Digital transcoding"
msgctxt "#36429"
msgid "Select this if the audio out connection only supports multichannel audio as Dolby Digital 5.1 (AC-3), such as a S/PDIF connection. When E-AC3 passthrough is also enabled, Dolby Digital Plus (E-AC3) is used for higher quality. If your system supports PCM multichannel audio via HDMI, leave this disabled."
msgstr ""

#. Description for setting category #14101: "Video Acceleration"
msgctxt "#36430"
msgid "Configure how video processing will be accelerated. This includes things like decoding and scaling."
msgstr "Konfigurišite kako će se ubrzati obrada videa. To uključuje stvari poput dekodiranja i skaliranja."

#. Description of setting with label #13438 "Show event log"
msgctxt "#36431"
msgid "Shows all events in the event log for the current profile with options to only show specific levels."
msgstr "Prikazuje sve događaje u dnevniku događaja za trenutni profil s opcijama za prikaz samo određenih nivoa."

#. Description for setting #310: "Virtual keyboard layouts"
#. Setting in Interface -> Regional -> Virtual keyboard layouts
#. Select the layout of a virtual keyboard
msgctxt "#36432"
msgid "Select virtual keyboard layouts."
msgstr "Odaberite rasporede virtuelne tastature."

#. Description for video related setting #13457: "vaapi sw filter"
msgctxt "#36433"
msgid "When enabled, VAAPI render method is preferred and the CPU has less load. If you experience hangs, disable this option."
msgstr "Kada je omogućeno, VAAPI metoda renderiranja je preferirana i CPU ima manje opterećenje. Ako dođe do zastoja, onemogućite ovu opciju."

msgctxt "#36434"
msgid "If enabled, switch to the channel with the programme to remind when auto-closing the reminder popup."
msgstr "Ako je omogućeno, prebacite se na kanal s programom za podsjetnik prilikom automatskog zatvaranja skočnog prozora podsjetnika."

msgctxt "#36435"
msgid "Sort channel groups by the order supplied by the backend(s). If enabled, groups cannot be reordered in the Group manager"
msgstr "Sortiraj grupe kanala prema redoslijedu koji je određen od izakraja. Ako je omogućeno, grupe se ne mogu mijenjati u upravitelju grupa"

# empty string with id 36435
#. Description for setting #407: "Hardware keyboard layouts"
#. Setting in System -> Input -> Hardware keyboard layouts
#. Select the layout of a physically attached keyboard
msgctxt "#36436"
msgid "Select hardware keyboard layout."
msgstr "Odaberite raspored hardverske tastature."

#. Option for setting "System -> Add-ons -> Update official add-ons from"
msgctxt "#36437"
msgid "Official repositories only (default)"
msgstr "Samo službeni repozitoriji (zadano)"

#. Option for setting "System -> Add-ons -> Update official add-ons from"
msgctxt "#36438"
msgid "Any repositories"
msgstr "Bilo koji repozitorij"

#. Description of setting with label #19352 "Play next programme automatically"
msgctxt "#36439"
msgid "Enable automatic playback of the next programme when playing past programmes (catchup) or for Video On Demand (VOD) channels. Please note that catchup and VOD only work if supported by the channel provider."
msgstr "Omogućite automatsku reprodukciju sljedećeg programa prilikom reprodukcije prošlih programa (naknadno reprodukcija) ili za kanale s videom na zahtjev (VOD). Imajte na umu da naknadno reprodukcija i VOD funkcioniraju samo ako ih podržava dobavljač kanala."

#. Description of setting with label #14085 "Video disc insert action"
msgctxt "#36440"
msgid "Action to take when a video disc is inserted."
msgstr ""

#. Description of setting with label #14097 "Audio CD Insert Action"
msgctxt "#36441"
msgid "Action to take when an audio CD is inserted."
msgstr ""

# empty strings from id 36439 to 36441
#. Description of setting "System -> Audio output -> Volume control steps" with label #1302
msgctxt "#36442"
msgid "Set the number of volume control steps."
msgstr "Podesite broj koraka za kontrolu jačine zvuka."

#. Description of setting with label #14126 "Whitelist"
msgctxt "#36443"
msgid "Whitelisted modes give the user the control to choose which display modes are allowed or not allowed to be used"
msgstr "Režimi na bijeloj listi daju korisniku kontrolu nad odabirom koji režimi prikaza su dozvoljeni, a koji nisu dozvoljeni za korištenje"

#. Description of setting with label #14127 "Whitelist"
msgctxt "#36444"
msgid "Select this option to allow using 3:2 pulldown refresh rates (playing 23.976 FPS video on a 59.94 Hz monitor or playing 24 FPS video on a 60 Hz monitor). You may want to use this option if your monitor doesn't have a 23.976 Hz or 24 Hz mode."
msgstr "Odaberite ovu opciju kako biste omogućili korištenje brzine osvježavanja 3:2 (reprodukcija videa od 23,976 FPS na monitoru od 59,94 Hz ili reprodukcija videa od 24 FPS na monitoru od 60 Hz). Ovu opciju možete koristiti ako vaš monitor nema način rada od 23,976 Hz ili 24 Hz."

#. Description of setting with label #14128 "Whitelist"
msgctxt "#36445"
msgid "Select this option to allow using double refresh rates (playing 29.97 FPS video on a 59.94 Hz monitor or playing 30 FPS video on a 60 Hz monitor). You may want to use this option if your monitor doesn't have a 29.97 Hz or 30 Hz mode."
msgstr "Odaberite ovu opciju kako biste omogućili korištenje dvostrukih brzina osvježavanja (reprodukcija videa od 29,97 FPS na monitoru od 59,94 Hz ili reprodukcija videa od 30 FPS na monitoru od 60 Hz). Ovu opciju možete koristiti ako vaš monitor nema način rada od 29,97 Hz ili 30 Hz."

#. Value of the track order settings #36448 #36450 #36452
msgctxt "#36446"
msgid "Sorted"
msgstr ""

#. Name of the setting of the stream order in the stream selection screen and the OSD for video files
msgctxt "#36447"
msgid "Video file stream display order"
msgstr ""

#. Description of setting with label #36447 "Video file stream display order"
msgctxt "#36448"
msgid "Video files only: display order in the stream selection dialogs. [Media] stream order in the media, [Sorted] sorted using the stream attributes[CR]"
msgstr ""

# empty strings from id 36446 to 36459
#. Description of settings with label #14112 "Enable event logging"
msgctxt "#36460"
msgid "Event logging allows to keep track of what has happened."
msgstr "Zapisivanje događaja omogućava praćenje onoga što se dogodilo."

#. Description of settings with label #14113 "Enable notification event logging"
msgctxt "#36461"
msgid "Notification event describe regular processes and actions performed by the system or the user."
msgstr "Obavještenja opisuju redovne procese i radnje koje izvršava sistem ili korisnik."

