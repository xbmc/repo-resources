# empty string with id 39126
msgctxt "#39127"
msgid "Use all local image files as artwork"
msgstr "Koristite sve lokalne slikovne datoteke kao umjetničko djelo"

#. Description of setting with label #39127 "Use all local image files as artwork"
msgctxt "#39128"
msgid "All image files located alongside the media files are picked up as artwork during library scan, with the file name as the art type."
msgstr "Sve slikovne datoteke koje se nalaze uz medijske datoteke prepoznaju se kao umjetnička djela tokom skeniranja biblioteke, a naziv datoteke označava vrstu umjetničkog djela."

msgctxt "#39129"
msgid "Use all remote artwork fetched by scrapers"
msgstr "Koristi sve udaljene umjetničke radove koje su preuzeli scraperi"

#. Description of setting with label #39129 "Use all remote artwork fetched by scrapers"
msgctxt "#39130"
msgid "Use the first of each art type of the remote artwork in scraper results to fill any missing art not populated with local art."
msgstr "Koristite prvi od svake vrste umjetničkog djela udaljenog umjetničkog djela u rezultatima struganja da biste popunili bilo koje nedostajuće umjetničko djelo koje nije popunjeno lokalnim umjetničkim djelom."

msgctxt "#39131"
msgid "Artist art types whitelist"
msgstr "Bijela lista vrsta umjetničkih djela umjetnika"

#. Description of setting with label #39131 "Artist art types whitelist"
msgctxt "#39132"
msgid "Limit the artist artwork fetched locally or applied from scraper remote art results to just those art types in the whitelist"
msgstr "Ograničite umjetnička djela preuzeta lokalno ili primijenjena iz rezultata udaljene umjetnosti scraper-a samo na one vrste umjetničkih djela na bijeloj listi"

msgctxt "#39133"
msgid "Album art types whitelist"
msgstr "Bijela lista tipova omotova albuma"

#. Description of setting with label #39133 "Album art types whitelist"
msgctxt "#39134"
msgid "Limit the album artwork fetched locally or applied from scraper remote art results to just those art types in the whitelist"
msgstr "Ograničite lokalno preuzete ili primijenjene omote albuma iz rezultata udaljenih omota scrapera samo na one vrste omota na bijeloj listi"

msgctxt "#39135"
msgid "Thumbnail image files"
msgstr "Datoteke sličica"

#. Description of setting with label #39135 "Thumbnail image files"
msgctxt "#39136"
msgid "The names of files that contain primary artwork (thumbnails), generally square and used both full and in reduced size to visually identify a folder, artist, album or song"
msgstr "Nazivi datoteka koje sadrže primarne ilustracije (sličice), uglavnom kvadratnog oblika i koriste se i u punoj i u smanjenoj veličini za vizualnu identifikaciju mape, izvođača, albuma ili pjesme"

msgctxt "#39137"
msgid "Artwork level"
msgstr "Nivo umjetničkog djela"

#. Description of setting with label #39137 "Artwork level"
msgctxt "#39138"
msgid "The amount of artwork automatically selected - [Maximum] all local images and remote art; [Basic] save space on limited devices or when using a simple skin; [Custom] configured by user for detailed control; [None] no art"
msgstr "Količina automatski odabranih umjetničkih djela - [Maksimalno] sve lokalne slike i udaljena umjetnička djela; [Osnovno] ušteda prostora na ograničenom broju uređaja ili pri korištenju jednostavne skinove; [Prilagođeno] konfigurirano od strane korisnika za detaljnu kontrolu; [Nijedan] bez umjetničkih djela"

# empty string with id 39139
#. Value of setting with label #39137 "Artwork level"
msgctxt "#39140"
msgid "Maximum"
msgstr "Maksimalno"

#. Value of setting with label #39137 "Artwork level"
msgctxt "#39141"
msgid "Basic"
msgstr "Osnovno"

#. Value of setting with label #39137 "Artwork level"
msgctxt "#39142"
msgid "Custom"
msgstr "Prilagođeno"

msgctxt "#39143"
msgid "Movie art types whitelist"
msgstr "Bijela lista vrsta filmske umjetnosti"

#. Description of setting with label #39150 "Movie art types whitelist"
msgctxt "#39144"
msgid "Limit the movie and movie set artwork fetched locally or applied from scraper remote art results to just those art types in the whitelist"
msgstr "Ograničite lokalno preuzete ili primijenjene ilustracije filmova i filmskih setova iz rezultata scraper udaljenih ilustracija samo na one vrste ilustracija na bijeloj listi"

msgctxt "#39145"
msgid "TV show art types whitelist"
msgstr "Bijela lista tipova umjetničkih djela TV emisija"

#. Description of setting with label #39152 "TV show art types whitelist"
msgctxt "#39146"
msgid "Limit the TV show and season artwork fetched locally or applied from scraper remote art results to just those art types in the whitelist"
msgstr "Ograničite lokalno preuzete ili primijenjene ilustracije TV emisija i sezona iz rezultata scraper udaljenih ilustracija samo na one vrste ilustracija na bijeloj listi"

msgctxt "#39147"
msgid "Episode art types whitelist"
msgstr "Bijela lista tipova ilustracija epizoda"

#. Description of setting with label #39154 "Episode art types whitelist"
msgctxt "#39148"
msgid "Limit the episode artwork fetched locally or applied from scraper remote art results to just those art types in the whitelist"
msgstr "Ograničite lokalno preuzete ili primijenjene ilustracije epizode iz rezultata scraper udaljenih ilustracija samo na one vrste ilustracija na bijeloj listi"

msgctxt "#39149"
msgid "Music video art types whitelist"
msgstr "Bijela lista vrsta muzičkih video umjetnina"

#. Description of setting with label #39156 "Music video art types whitelist"
msgctxt "#39150"
msgid "Limit the music video artwork fetched locally or applied from scraper remote art results to just those art types in the whitelist"
msgstr "Ograničite lokalno preuzete ili primijenjene umjetničke slike iz muzičkih spotova iz programa scraper na samo one vrste umjetničkih djela na bijeloj listi"

